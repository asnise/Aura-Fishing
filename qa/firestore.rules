rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Three QA documents. Anyone can read (the page and agents' pull.mjs need it);
    // only the listed Google accounts (verified email) can write.
    match /qa/{doc} {
      allow read: if doc in ['state', 'tickets', 'ideas'];
      allow write: if doc in ['state', 'tickets', 'ideas']
        && request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['banktheerawach@gmail.com', 'nattaset.55@gmail.com', 'nattasetpanlek@gmail.com', 'puayrito@gmail.com', 'lowquality91@gmail.com'];
    }
  }
}
