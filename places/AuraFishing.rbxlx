					<Item class="ModuleScript" referent="46">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Cast popup (Figma: "15 · Cast Popup" / "16 · Cast Popup — Auto depth").
-- Opens when the player presses CAST (unless Auto depth is on) or taps the DEPTH button.
-- CastPopup.Open({ depth, maxDepth, auto, onConfirm = function(depth, auto) end })

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared.Registry)
local Roll = require(Shared.Roll)

local New = require(script.Parent.New)

local T = New.Theme
local WIDTH = 470
local INNER = WIDTH - 28

local CastPopup = {}

local current: Frame? = nil
local inputConns: { RBXScriptConnection } = {}

local function cleanup()
	for _, c in inputConns do
		c:Disconnect()
	end
	table.clear(inputConns)
	if current then
		current:Destroy()
		current = nil
	end
end

function CastPopup.IsOpen(): boolean
	return current ~= nil
end

function CastPopup.Close()
	cleanup()
end

local function zoneFor(depth: number)
	return Registry.DepthZoneFor(depth)
end

function CastPopup.Open(opts: any)
	cleanup()
	local gui = opts.Gui
	local maxDepth = math.max(1, math.floor(opts.maxDepth or 30))
	local depth = math.clamp(math.floor(opts.depth or 10), 0, maxDepth)
	local auto = opts.auto == true
	local profile = opts.profile

	local root = New("Frame", {
		Name = "CastPopup",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(WIDTH, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.Panel,
		ZIndex = 20,
		Parent = gui,
		[New.Children] = {
			New.Corner(28),
			New.Stroke(),
			New.Padding(14),
			New("UIListLayout", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
		},
	}) :: Frame
	current = root

	-- header
	local header = New("Frame", { Size = UDim2.fromOffset(INNER, 40), BackgroundTransparency = 1, LayoutOrder = 1, Parent = root })
	New.Title({ Size = UDim2.new(1, -60, 1, 0), Text = "Cast", TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 26, Parent = header })
	local close = New.Button({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(48, 40), Text = "X", BackgroundColor3 = T.Bad, Parent = header })
	close.Activated:Connect(cleanup)

	-- auto toggle row
	local autoRow = New("TextButton", {
		Size = UDim2.fromOffset(INNER, 70),
		BackgroundColor3 = T.PanelLight,
		Text = "",
		AutoButtonColor = false,
		LayoutOrder = 2,
		Parent = root,
		[New.Children] = { New.Corner(16), New.Padding(12) },
	})
	local box = New("Frame", { Size = UDim2.fromOffset(30, 30), Position = UDim2.new(0, 0, 0.5, -15), Parent = autoRow, [New.Children] = { New.Corner(9) } })
	local boxStroke = New.Stroke(T.Track, 2)
	boxStroke.Parent = box
	local tick = New.Title({ Size = UDim2.fromScale(1, 1), Text = "✓", TextColor3 = T.OnAccent, MaxTextSize = 20, Parent = box })
	New.Title({ Position = UDim2.fromOffset(44, 0), Size = UDim2.new(1, -44, 0, 22), Text = "Auto depth", TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 20, Parent = autoRow })
	New.Text({
		Position = UDim2.fromOffset(44, 24),
		Size = UDim2.new(1, -44, 0, 20),
		Text = "Random depth your line can reach, every cast. CAST won't ask again.",
		TextColor3 = T.SubText,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 13,
		Parent = autoRow,
	})

	-- manual controls
	local manual = New("Frame", {
		Size = UDim2.fromOffset(INNER, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = root,
		[New.Children] = { New("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }) },
	})
	local readout = New("Frame", { Size = UDim2.fromOffset(INNER, 50), BackgroundTransparency = 1, LayoutOrder = 1, Parent = manual,
		[New.Children] = { New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center }) } })
	local depthLabel = New("TextLabel", { Size = UDim2.fromOffset(0, 50), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Text = "", FontFace = T.Font, TextSize = 44, TextColor3 = T.Text, Parent = readout })
	local zonePill = New("TextLabel", {
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = T.Sky,
		Text = "",
		FontFace = T.FontBody,
		TextSize = 12,
		TextColor3 = T.OnAccent,
		LayoutOrder = 2,
		Parent = readout,
		[New.Children] = { New.Pill(), New("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }) },
	})

	-- slider with zone bands
	local sliderHolder = New("Frame", { Size = UDim2.fromOffset(INNER, 34), BackgroundTransparency = 1, LayoutOrder = 2, Parent = manual })
	local track = New("Frame", {
		Position = UDim2.fromOffset(0, 8),
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundColor3 = T.Track,
		ClipsDescendants = true,
		Parent = sliderHolder,
		[New.Children] = { New.Pill() },
	})
	for _, z in Registry.DepthZones do
		local a, b = z.Min, math.min(z.Max, maxDepth)
		if a <= maxDepth and b > a then
			New("Frame", {
				Position = UDim2.fromScale(a / maxDepth, 0),
				Size = UDim2.fromScale((b - a) / maxDepth, 1),
				BackgroundColor3 = z.Color:Lerp(Color3.new(1, 1, 1), 0.55),
				BorderSizePixel = 0,
				Parent = track,
			})
		end
	end
	local knob = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromOffset(0, 2),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 22,
		Parent = sliderHolder,
		[New.Children] = { New.Pill(), New.Stroke(T.SkyLip, 3) },
	})
	local scaleRow = New("Frame", { Size = UDim2.fromOffset(INNER, 14), BackgroundTransparency = 1, LayoutOrder = 3, Parent = manual })
	New.Text({ Size = UDim2.fromScale(0.5, 1), Text = "0m", TextColor3 = T.SubText, TextXAlignment = Enum.TextXAlignment.Left, MaxTextSize = 12, Parent = scaleRow })
	New.Text({ Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromScale(0.5, 1), Text = `{maxDepth}m (line)`, TextColor3 = T.SubText, TextXAlignment = Enum.TextXAlignment.Right, MaxTextSize = 12, Parent = scaleRow })

	local presetsRow = New("Frame", { Size = UDim2.fromOffset(INNER, 50), BackgroundTransparency = 1, LayoutOrder = 4, Parent = manual,
		[New.Children] = { New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }) } })
	local presets = {
		{ "Shallow", math.min(20, maxDepth) },
		{ "Mid", math.floor(maxDepth / 2) },
		{ "Max", maxDepth },
	}
	local presetButtons = {}
	local species = New.Text({ Size = UDim2.fromOffset(INNER, 18), Text = "", TextColor3 = T.SubText, MaxTextSize = 14, LayoutOrder = 5, Parent = manual })

	local function refresh()
		depthLabel.Text = `{depth}m`
		local z = zoneFor(depth)
		zonePill.Text = string.upper(z.Name)
		zonePill.BackgroundColor3 = z.Color:Lerp(Color3.new(1, 1, 1), 0.25)
		knob.Position = UDim2.new(depth / maxDepth, 0, 0, 2)
		local ids = Roll.Candidates(depth, nil)
		local found = 0
		for _, id in ids do
			if profile and profile.Fishdex[id] then
				found += 1
			end
		end
		species.Text = if #ids > 0 then `{#ids} species live here  •  {found} discovered` else "No fish at this depth"
		for i, b in presetButtons do
			New.SetButtonColor(b, if presets[i][2] == depth then T.Accent else T.PanelLight)
		end
		box.BackgroundColor3 = if auto then T.Good else T.Panel
		boxStroke.Color = if auto then T.GoodLip else T.Track
		tick.Visible = auto
		autoRow.BackgroundColor3 = if auto then T.Good:Lerp(Color3.new(1, 1, 1), 0.78) else T.PanelLight
		manual.Visible = not auto
	end

	for i, p in presets do
		local b = New.Button({ Size = UDim2.new(1 / 3, -6, 1, 0), Text = `{p[1]} {p[2]}m`, MaxTextSize = 17, LayoutOrder = i, Parent = presetsRow })
		b.Activated:Connect(function()
			depth = p[2]
			refresh()
		end)
		presetButtons[i] = b
	end

	-- dragging
	local dragging = false
	local function fromX(x: number)
		local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
		depth = math.floor(rel * maxDepth + 0.5)
		refresh()
	end
	local function isPress(input: InputObject)
		return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
	end
	for _, target in { track, knob } do
		table.insert(inputConns, target.InputBegan:Connect(function(input)
			if isPress(input) then
				dragging = true
				fromX(input.Position.X)
			end
		end))
	end
	table.insert(inputConns, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromX(input.Position.X)
		end
	end))
	table.insert(inputConns, UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then
			dragging = false
		end
	end))

	autoRow.Activated:Connect(function()
		auto = not auto
		refresh()
	end)

	local castBtn = New.Button({ Size = UDim2.fromOffset(INNER, 56), Text = "CAST!", BackgroundColor3 = T.Accent, MaxTextSize = 28, LayoutOrder = 4, Parent = root })
	castBtn.Activated:Connect(function()
		local d, a = depth, auto
		cleanup()
		if opts.onConfirm then
			opts.onConfirm(d, a)
		end
	end)

	refresh()
end

return CastPopup
]]></ProtectedString>
