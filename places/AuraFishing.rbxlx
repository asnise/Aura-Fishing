					</Item>
					<Item class="ModuleScript" referent="40">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Client side of fishing: input, "!" bite prompt, and the Pond Card reel minigame (GDD 3.2, Figma 03 / option D).
-- The minigame result is validated on the server (see FishingService.onReelResult).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared.Registry)
local Remotes = require(Shared.Remotes)
local UIAssets = require(Shared.Config.UIAssets)

local New = require(script.Parent.Parent.UI.New)
local CastPopup = require(script.Parent.Parent.UI.CastPopup)
local HUD = require(script.Parent.HUDController)
local DataController = require(script.Parent.DataController)

local T = New.Theme
local MG = Registry.GameConfig.Minigame
local player = Players.LocalPlayer

local FishingController = {}

local phase = "Idle"
local biteToken: string? = nil
local holding = false
local minigameActive = false

-- Reel minigame: "Pond Card" (Figma: 03 · Reel Minigame / Reel options D) -------------
-- Hold to lift the mint catch bar, release to let it sink; keep it over the (mystery) fish.
-- The REEL meter fills while the fish is inside. Tension chips: GOOD (on the fish),
-- LOOSE (slipping), SNAP! (about to lose it). The species stays hidden until the catch.

local PANEL_W = 232
local WATER_W, WATER_H = 130, 286
local METER_W, METER_H = 26, 254

local function chip(parent: Instance, text: string, order: number): TextLabel
	return New("TextLabel", {
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = T.PanelLight,
		Text = text,
		TextColor3 = T.SubText,
		FontFace = T.FontBody,
		TextSize = 12,
		LayoutOrder = order,
		Parent = parent,
		[New.Children] = { New.Pill(), New("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }) },
	}) :: TextLabel
end

local function runMinigame(token: string, p: any)
	minigameActive = true
	local rarity = Registry.Rarities[p.Rarity]

	local root = New("Frame", {
		Name = "ReelMinigame",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(PANEL_W, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.Panel,
		Parent = HUD.Gui,
		[New.Children] = {
			New.Corner(26),
			New.Stroke(),
			New.Padding(16),
			New("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
		},
	})

	-- header: rarity tag, depth, time left
	local header = New("Frame", { Size = UDim2.fromOffset(PANEL_W - 32, 24), BackgroundTransparency = 1, LayoutOrder = 1, Parent = root,
		[New.Children] = { New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Center }) } })
	local tag = chip(header, string.upper(rarity.Name), 1)
	tag.BackgroundColor3 = rarity.Color
	tag.TextColor3 = T.OnAccent
	local depthChip = chip(header, `{p.Depth or 0}m`, 2)
	depthChip.BackgroundColor3 = T.Sky
	depthChip.TextColor3 = T.OnAccent
	local timer = New("TextLabel", { Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1, Text = "",
		TextColor3 = T.SubText, FontFace = T.Font, TextSize = 20, LayoutOrder = 3, Parent = header })

	-- body: water column + REEL meter
	local body = New("Frame", { Size = UDim2.fromOffset(WATER_W + 14 + METER_W, WATER_H), BackgroundTransparency = 1, LayoutOrder = 2, Parent = root })
	local water = New("Frame", {
		Size = UDim2.fromOffset(WATER_W, WATER_H),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		Parent = body,
		[New.Children] = {
			New.Corner(18),
			New("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(190, 230, 250), Color3.fromRGB(76, 143, 199)) }),
		},
	})
	-- decorative bubbles (Frames; seaweed/bubble art can replace them once uploaded)
	for _, b in { { 0.72, 0.06, 12 }, { 0.82, 0.14, 8 }, { 0.2, 0.35, 6 }, { 0.65, 0.6, 9 } } do
		New("Frame", { Position = UDim2.fromScale(b[1], b[2]), Size = UDim2.fromOffset(b[3], b[3]), BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.45, Parent = water, [New.Children] = { New.Pill() } })
	end
	local bar = New("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Size = UDim2.new(1, 0, p.CatchBarSize, 0),
		BackgroundColor3 = T.Good,
		BackgroundTransparency = 0.2,
		ZIndex = 2,
		Parent = water,
		[New.Children] = { New.Corner(16), New.Stroke(Color3.new(1, 1, 1), 3) },
	})
	-- mystery fish: art if uploaded, otherwise a slate glyph (never the real species)
	local fishArt = UIAssets.GetArt("fish/MysteryFish")
	local fishIcon: GuiObject
	if UIAssets.IsUploaded(fishArt) then
		fishIcon = New("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(58, 58), BackgroundTransparency = 1,
			Image = fishArt, ZIndex = 3, Parent = water })
	else
		fishIcon = New.Title({ AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(52, 32), Text = "><>", TextColor3 = T.Text,
			TextStrokeTransparency = 0, TextStrokeColor3 = Color3.new(1, 1, 1), MaxTextSize = 26, ZIndex = 3, Parent = water })
	end

	local meter = New("Frame", { Position = UDim2.fromOffset(WATER_W + 14, 0), Size = UDim2.fromOffset(METER_W, WATER_H), BackgroundTransparency = 1, Parent = body })
	New.Text({ Size = UDim2.fromOffset(METER_W + 20, 16), Position = UDim2.fromOffset(-10, 0), Text = "REEL", TextColor3 = T.SubText, MaxTextSize = 12, Parent = meter })
	local meterTrack = New("Frame", {
		Position = UDim2.fromOffset(0, WATER_H - METER_H),
		Size = UDim2.fromOffset(METER_W, METER_H),
		BackgroundColor3 = T.Track,
		ClipsDescendants = true,
		Parent = meter,
		[New.Children] = { New.Pill() },
	})
	local meterFill = New("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, MG.StartProgress),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = meterTrack,
		[New.Children] = { New.Pill(), New("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 212, 92), T.Gold) }) },
	})
	local bobber = New("Frame", { -- rides on top of the fill
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(24, 24),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 3,
		Parent = meter,
		[New.Children] = { New.Pill(), New.Stroke(Color3.new(1, 1, 1), 2),
			New("UIGradient", { Rotation = 90, Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, T.Accent), ColorSequenceKeypoint.new(0.5, T.Accent),
				ColorSequenceKeypoint.new(0.501, T.Panel), ColorSequenceKeypoint.new(1, T.Panel) }) }) },
	})

	-- tension chips
	local chipsRow = New("Frame", { Size = UDim2.fromOffset(PANEL_W - 32, 22), BackgroundTransparency = 1, LayoutOrder = 3, Parent = root,
		[New.Children] = { New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center }) } })
	local chips = { LOOSE = chip(chipsRow, "LOOSE", 1), GOOD = chip(chipsRow, "GOOD", 2), SNAP = chip(chipsRow, "SNAP!", 3) }
	local chipColors = { LOOSE = T.Gold, GOOD = T.Good, SNAP = T.Bad }
	local tension = ""
	local function setTension(state: string)
		if state == tension then
			return
		end
		tension = state
		for k, c in chips do
			local on = k == state
			c.BackgroundColor3 = if on then chipColors[k] else T.PanelLight
			c.TextColor3 = if on then T.OnAccent else T.SubText
		end
	end

	New.Text({
		Size = UDim2.fromOffset(PANEL_W - 32, 14),
		Text = if UserInputService.TouchEnabled then "Hold the screen to reel" else "Hold click / Space to reel",
		TextColor3 = T.SubText,
		MaxTextSize = 12,
		LayoutOrder = 4,
		Parent = root,
	})

	-- simulation (0..1 along the water column, 0 = bottom)
	local pattern = p.PatternDef
	local barSize = p.CatchBarSize
	local barPos, barVel = 0, 0
	local fishPos, fishTarget = 0.5, 0.5
	local burstTime = 0
	local progress = MG.StartProgress
	local perfect = true
	local elapsed = 0
	local speed = pattern.Speed * (1 + (p.Difficulty - 1) * MG.DifficultySpeedScale) * (1 - p.FishStability)
	local rng = Random.new()

	local function pickTarget()
		local t = rng:NextNumber()
		if pattern.Bias then
			t = (t + pattern.Bias * 2) / 3
		end
		fishTarget = math.clamp(t, 0.06, 0.94)
	end

	local conn
	local function finish(success: boolean)
		if not minigameActive then
			return
		end
		minigameActive = false
		conn:Disconnect()
		root:Destroy()
		Remotes.Event("ReelResult"):FireServer(token, success, success and perfect)
	end

	conn = RunService.RenderStepped:Connect(function(dt)
		dt = math.min(dt, 0.1)
		elapsed += dt

		if holding then
			barVel += MG.BarLift * dt
		else
			barVel -= MG.BarGravity * dt
		end
		barVel = math.clamp(barVel, -1.6, 1.6)
		barPos += barVel * dt
		if barPos < 0 then
			barPos, barVel = 0, 0
		elseif barPos > 1 - barSize then
			barPos, barVel = 1 - barSize, 0
		end

		if rng:NextNumber() < pattern.Jitter * dt then
			pickTarget()
		end
		if burstTime <= 0 and rng:NextNumber() < pattern.BurstChance * dt then
			burstTime = 0.35
			pickTarget()
		end
		local s = speed * (if burstTime > 0 then 3 else 1)
		burstTime -= dt
		fishPos += math.clamp(fishTarget - fishPos, -s * dt, s * dt)

		local inside = fishPos >= barPos and fishPos <= barPos + barSize
		if inside then
			progress += MG.GainPerSecond * p.ReelPower * dt
		else
			perfect = false
			progress -= MG.LossPerSecond * (1 - p.Resilience) * dt
		end

		local pc = math.clamp(progress, 0, 1)
		bar.Position = UDim2.fromScale(0, 1 - barPos)
		bar.BackgroundTransparency = if inside then 0.15 else 0.45
		fishIcon.Position = UDim2.fromScale(0.5, 1 - fishPos)
		meterFill.Size = UDim2.fromScale(1, pc)
		bobber.Position = UDim2.new(0.5, 0, 0, (WATER_H - METER_H) + METER_H * (1 - pc))
		setTension(if inside then "GOOD" elseif progress > MG.SnapWarning then "LOOSE" else "SNAP")
		local left = math.max(0, MG.MaxDuration - elapsed)
		timer.Text = string.format("%d:%02d", math.floor(left / 60), math.floor(left % 60))

		if progress >= 1 then
			finish(true)
		elseif progress <= 0 or elapsed > MG.MaxDuration then
			finish(false)
		end
	end)
end

-- Input ------------------------------------------------------------------------------

-- Cast popup: CAST opens it unless Auto depth is on; the DEPTH button always opens it.
local function openCastPopup()
	local profile = DataController.Profile
	CastPopup.Open({
		Gui = HUD.Gui,
		profile = profile,
		depth = HUD.TargetDepth,
		maxDepth = HUD.MaxDepth(),
		auto = profile and profile.Settings.AutoDepth == true,
		onConfirm = function(depth: number, auto: boolean)
			local setting = Remotes.Func("SetSetting")
			if profile and (profile.Settings.AutoDepth == true) ~= auto then
				setting:InvokeServer("AutoDepth", auto)
			end
			if not auto then
				HUD.TargetDepth = depth
				setting:InvokeServer("TargetDepth", depth)
			end
			if phase == "Idle" then
				Remotes.Event("Cast"):FireServer(if auto then -1 else depth)
			end
		end,
	})
end

local function onAction()
	if minigameActive or CastPopup.IsOpen() then
		return
	end
	if phase == "Idle" then
		local profile = DataController.Profile
		if profile and profile.Settings.AutoDepth == true then
			Remotes.Event("Cast"):FireServer(-1)
		else
			openCastPopup()
		end
	elseif phase == "Bite" and biteToken then
		Remotes.Event("Hook"):FireServer(biteToken)
		biteToken = nil
	elseif phase == "Waiting" then
		Remotes.Event("CancelFishing"):FireServer()
	end
end

local function isHoldInput(input: InputObject): boolean
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
		or input.KeyCode == Enum.KeyCode.Space
		or input.KeyCode == Enum.KeyCode.ButtonA
end

function FishingController.Init()
	HUD.CastPressed:Connect(onAction)
	HUD.DepthPressed:Connect(function()
		if not minigameActive and not CastPopup.IsOpen() then
			openCastPopup()
		end
	end)
	HUD.AutoToggled:Connect(function(on)
		Remotes.Event("SetAuto"):FireServer(on)
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not isHoldInput(input) then
			return
		end
		if minigameActive then
			holding = true -- reeling works even when the press lands on UI
			return
		end
		if processed then
			return
		end
		-- clicking the world also casts / hooks
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.KeyCode == Enum.KeyCode.ButtonA then
			onAction()
		elseif input.KeyCode == Enum.KeyCode.Space and phase == "Bite" then
			onAction()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if isHoldInput(input) then
			holding = false
		end
	end)

	Remotes.Event("FishingState").OnClientEvent:Connect(function(newPhase, info)
		phase = newPhase
		if newPhase == "Idle" then
			HUD.SetStatus(nil)
			HUD.SetCastButton("CAST")
			HUD.SetAuto(false)
		elseif newPhase == "Waiting" then
			HUD.SetStatus(`Waiting... ({info and info.Depth or 0}m)`, T.SubText)
			HUD.SetCastButton("REEL IN", T.PanelLight)
		elseif newPhase == "Bite" then
			local r = info and Registry.Rarities[info.Rarity]
			HUD.SetStatus("!", r and r.Color or T.Gold)
			HUD.SetCastButton("HOOK!", T.Gold)
		elseif newPhase == "Reeling" then
			HUD.SetStatus(nil)
			HUD.SetCastButton("REELING", T.PanelLight)
		elseif newPhase == "Auto" then
			HUD.SetStatus("Auto fishing...", T.Good)
			HUD.SetCastButton("AUTO", T.PanelLight)
			HUD.SetAuto(true)
		end
	end)

	Remotes.Event("Bite").OnClientEvent:Connect(function(token)
		biteToken = token
	end)
	Remotes.Event("StartMinigame").OnClientEvent:Connect(function(token, params)
		holding = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
		runMinigame(token, params)
	end)

	player.CharacterRemoving:Connect(function()
		holding = false
	end)
end

return FishingController
]]></ProtectedString>
							<string name="ScriptGuid">{D187CDD9-5AD9-4148-853E-986D7DBD25B7}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">FishingController</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">7672d16ab309499b0b0c9ea400000403</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="41">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Main HUD (GDD 9): currencies/level, cast + DEPTH button, auto/sell buttons, notifications,
-- Layout keeps clear of Roblox CoreGui (docs/UI_STYLE.md "Roblox safe areas"): top bar (inset), leaderboard top-right,
-- chat top-left, mobile thumbstick bottom-left, mobile jump bottom-right.
-- catch popups. Builds everything in code so it works straight from Rojo.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared.Registry)
local Remotes = require(Shared.Remotes)
local Format = require(Shared.Util.Format)
local Signal = require(Shared.Util.Signal)

local Roll = require(Shared.Roll)

local New = require(script.Parent.Parent.UI.New)
local Modal = require(script.Parent.Parent.UI.Modal)
local DataController = require(script.Parent.DataController)

local T = New.Theme
local player = Players.LocalPlayer

local HUD = {}
HUD.Gui = nil :: ScreenGui?
HUD.CastPressed = Signal.new()
HUD.AutoToggled = Signal.new() -- (enabled)
HUD.MenuRequested = Signal.new() -- (menuName)
HUD.HubRequested = Signal.new() -- Main Menu hub button
HUD.TargetDepth = 10
HUD.DepthPressed = Signal.new() -- DEPTH button next to CAST

local refs: { [string]: any } = {}
local notifyHolder: Frame

-- Notifications ------------------------------------------------------------

function HUD.Notify(text: string, color: Color3?)
	if not notifyHolder then
		return
	end
	local label = New("TextLabel", {
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = T.Panel,
		Text = text,
		TextColor3 = color or T.Text,
		FontFace = T.FontBody,
		TextSize = 18,
		Parent = notifyHolder,
		[New.Children] = {
			New.Pill(),
			New.Stroke(),
			New("UIPadding", { PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16) }),
		},
	})
	task.delay(3, function()
		TweenService:Create(label, TweenInfo.new(0.5), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
		task.wait(0.5)
		label:Destroy()
	end)
end

function HUD.ShowCatch(result: any)
	local entry = result.Entry
	local fish = Registry.Fish[entry.Fish]
	local rarity = Registry.Rarities[fish.Rarity]
	local mut = entry.Mutation and Registry.Mutations[entry.Mutation]

	local card = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.16, 0),
		Size = UDim2.fromOffset(340, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.Panel,
		Parent = HUD.Gui,
		[New.Children] = {
			New.Corner(T.RadiusCard),
			New.Stroke(),
			New.Padding(10),
			New("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
		},
	})
	local title = (result.New and "NEW! " or "") .. (mut and (mut.Name .. " ") or "") .. fish.Name
	New.Title({ Size = UDim2.new(1, 0, 0, 30), Text = title, TextColor3 = mut and mut.Color or rarity.Color, MaxTextSize = 26, LayoutOrder = 1, Parent = card })
	local badges = { { Text = string.upper(rarity.Name), Color = rarity.Color }, { Text = `{entry.Weight} kg` }, { Text = result.Mode, Color = T.Sky } }
	if result.Perfect then
		table.insert(badges, { Text = "PERFECT", Color = T.Gold })
	end
	if mut then
		table.insert(badges, { Text = `{mut.Name} x{mut.ValueMultiplier}`, Color = mut.Color })
	end
	New.BadgeRow(badges, { LayoutOrder = 2, Parent = card })
	New.Text({
		Size = UDim2.new(1, 0, 0, 24),
		Text = `Worth {Format.Number(result.Value)} coins` .. (result.Gems > 0 and `  +{result.Gems} gems` or ""),
		TextColor3 = T.GoldLip,
		FontFace = T.Font,
		LayoutOrder = 3,
		Parent = card,
	})
	if result.LevelsGained > 0 then
		HUD.Notify(`LEVEL UP! +{result.LevelsGained * Registry.GameConfig.GemsPerLevel} gems`, T.Gem)
	end
	task.delay(2.6, function()
		card:Destroy()
	end)
end

-- Bite "!" ---------------------------------------------------------------------

function HUD.SetStatus(text: string?, color: Color3?)
	local s = refs.Status
	if not s then
		return
	end
	s.Visible = text ~= nil
	s.Text = text or ""
	s.TextColor3 = color or T.Text
end

function HUD.SetCastButton(text: string, color: Color3?)
	refs.Cast.Text = text
	New.SetButtonColor(refs.Cast, color or T.Accent)
end

-- Depth ------------------------------------------------------------------------
-- Depth is chosen in the Cast popup (UI/CastPopup). The HUD only shows a small DEPTH button
-- next to CAST ("AUTO" or "80m") that reopens the popup.

function HUD.MaxDepth(): number
	local stats = DataController.Stats
	return stats and stats.Values.MaxDepth or 30
end

function HUD.RefreshDepthButton()
	local profile = DataController.Profile
	if not refs.DepthValue or not profile then
		return
	end
	local auto = profile.Settings.AutoDepth == true
	HUD.TargetDepth = math.clamp(profile.Settings.TargetDepth or HUD.TargetDepth, 0, HUD.MaxDepth())
	refs.DepthValue.Text = if auto then "AUTO" else `{HUD.TargetDepth}m`
end

-- Build ------------------------------------------------------------------------

function HUD.Init()
	local gui = New("ScreenGui", {
		Name = "AuraFishingHUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	HUD.Gui = gui

	-- Top-left stats: HUD Stats style E "Minimal Floating" (Figma component "HUD Stats")
	-- No panel, no aura: outlined level + XP as text, then coin/gem chips.
	local function outlined(size: number, thickness: number): TextLabel
		return New("TextLabel", {
			Size = UDim2.fromOffset(0, size + 4),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			Text = "",
			TextColor3 = Color3.new(1, 1, 1),
			FontFace = T.Font,
			TextSize = size,
			[New.Children] = {
				New("UIStroke", { Color = T.Text, Thickness = thickness, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual, LineJoinMode = Enum.LineJoinMode.Round }),
			},
		}) :: TextLabel
	end
	local function currencyChip(dotColor: Color3, order: number): TextLabel
		local chip = New("Frame", {
			Size = UDim2.fromOffset(0, 34),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = T.Panel,
			LayoutOrder = order,
			[New.Children] = {
				New.Pill(),
				New.Stroke(),
				New("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 12) }),
				New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Center }),
				New("Frame", { Size = UDim2.fromOffset(22, 22), BackgroundColor3 = dotColor, [New.Children] = { New.Pill() } }),
			},
		})
		local value = New("TextLabel", {
			Size = UDim2.fromOffset(0, 22),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			Text = "0",
			TextColor3 = T.Text,
			FontFace = T.Font,
			TextSize = 18,
			LayoutOrder = 2,
			Parent = chip,
		})
		return value :: TextLabel, chip
	end

	local top = New("Frame", {
		Name = "HUDStats",
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundTransparency = 1,
		Parent = gui,
		[New.Children] = { New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) },
	})
	local levelRow = New("Frame", {
		Size = UDim2.fromOffset(0, 36),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = top,
		[New.Children] = { New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), VerticalAlignment = Enum.VerticalAlignment.Center }) },
	})
	refs.Level = outlined(30, 3)
	refs.Level.Parent = levelRow
	refs.XPText = outlined(16, 2.5)
	refs.XPText.LayoutOrder = 2
	refs.XPText.Parent = levelRow
	local currencies = New("Frame", {
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = top,
		[New.Children] = { New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) },
	})
	local coinChip, gemChip
	refs.Coins, coinChip = currencyChip(T.Gold, 1)
	refs.Gems, gemChip = currencyChip(T.Gem, 2)
	coinChip.Parent = currencies
	gemChip.Parent = currencies

	-- Notifications
	notifyHolder = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.new(0.6, 0, 0, 200),
		BackgroundTransparency = 1,
		Parent = gui,
		[New.Children] = { New("UIListLayout", { Padding = UDim.new(0, 2), HorizontalAlignment = Enum.HorizontalAlignment.Center }) },
	})

	-- Status ("Waiting...", "!")
	refs.Status = New.Text({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -222),
		Size = UDim2.fromOffset(300, 56),
		Text = "",
		Visible = false,
		BackgroundTransparency = 0,
		BackgroundColor3 = T.Panel,
		FontFace = T.Font,
		MaxTextSize = 40,
		Parent = gui,
	})
	New.Pill().Parent = refs.Status
	New.Stroke().Parent = refs.Status

	-- Cast button + DEPTH button (bottom centre, between the mobile thumbstick and jump)
	refs.Cast = New.Button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, -50, 1, -16),
		Size = UDim2.fromOffset(180, 76),
		Text = "CAST",
		BackgroundColor3 = T.Accent,
		MaxTextSize = 34,
		Parent = gui,
	})
	refs.Cast.Activated:Connect(function()
		HUD.CastPressed:Fire()
	end)

	local depthBtn = New.Button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0.5, 50, 1, -22),
		Size = UDim2.fromOffset(96, 64),
		Text = "",
		BackgroundColor3 = T.Panel,
		Parent = gui,
	})
	New.Stroke().Parent = depthBtn
	New.Text({ Size = UDim2.new(1, 0, 0, 14), Text = "DEPTH", TextColor3 = T.SubText, MaxTextSize = 12, Parent = depthBtn })
	refs.DepthValue = New.Title({ Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 24), Text = "AUTO", MaxTextSize = 20, Parent = depthBtn })
	depthBtn.Activated:Connect(function()
		HUD.DepthPressed:Fire()
	end)

	-- Bottom-right: bag / sell / auto
	local right = New("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, if UserInputService.TouchEnabled then -150 else -12),
		Size = UDim2.fromOffset(170, 150),
		BackgroundTransparency = 1,
		Parent = gui,
		[New.Children] = { New("UIListLayout", { Padding = UDim.new(0, 6), VerticalAlignment = Enum.VerticalAlignment.Bottom }) },
	})
	refs.Bag = New.Title({ Size = UDim2.new(1, 0, 0, 30), Text = "Bag 0/10", LayoutOrder = 1, BackgroundTransparency = 0, BackgroundColor3 = T.Panel, MaxTextSize = 18, Parent = right })
	New.Pill().Parent = refs.Bag
	New.Stroke().Parent = refs.Bag
	refs.Auto = New.Button({ Size = UDim2.new(1, 0, 0, 36), Text = "AUTO: OFF", LayoutOrder = 2, Parent = right })
	local sell = New.Button({ Size = UDim2.new(1, 0, 0, 36), Text = "SELL ALL", BackgroundColor3 = T.Gold, LayoutOrder = 3, Parent = right })
	local autoOn = false
	refs.Auto.Activated:Connect(function()
		autoOn = not autoOn
		HUD.AutoToggled:Fire(autoOn)
	end)
	function HUD.SetAuto(on: boolean)
		autoOn = on
		refs.Auto.Text = on and "AUTO: ON" or "AUTO: OFF"
		New.SetButtonColor(refs.Auto, on and T.Good or T.PanelLight)
	end
	sell.Activated:Connect(function()
		local profile = DataController.Profile
		local stats = DataController.Stats
		if not profile or #profile.Bag == 0 then
			HUD.Notify("Your bag is empty", T.Bad)
			return
		end
		-- preview with the same formula the server uses (ShopService.SellAll)
		local mult = stats and stats.Values.SellMultiplier or 1
		local total, mutated = 0, 0
		for _, entry in profile.Bag do
			total += Roll.Value(entry, mult)
			if entry.Mutation then
				mutated += 1
			end
		end
		local count = #profile.Bag
		Modal.Confirm({
			Title = `Sell all {count} fish?`,
			Message = `You'll get {Format.Number(total)} coins.` .. (if mutated > 0 then ` {mutated} fish with mutations are included.` else ""),
			ConfirmText = "Sell",
			ConfirmColor = T.Gold,
			Icon = "ui/status/sell_bag",
			IconColor = T.Gold,
		}, function()
			local ok, msg = Remotes.Func("SellAll"):InvokeServer()
			HUD.Notify(msg, ok and T.Gold or T.Bad)
		end)
	end)

	-- Right-side menu buttons
	local menu = New("Frame", {
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0, 12, 0, 234), -- Figma y 292 minus the 58px top bar (below the chat window)
		Size = UDim2.fromOffset(110, 174),
		BackgroundTransparency = 1,
		Parent = gui,
		[New.Children] = { New("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }) },
	})
	for i, name in { "Shop", "Auras", "Fishdex" } do
		local b = New.Button({ Size = UDim2.new(1, 0, 0, 38), Text = name, LayoutOrder = i, Parent = menu })
		b.Activated:Connect(function()
			HUD.MenuRequested:Fire(name)
		end)
	end
	-- Main Menu hub (Figma 12); keyboard: M
	local hubBtn = New.Button({ Size = UDim2.new(1, 0, 0, 38), Text = "Menu", BackgroundColor3 = T.Sky, LayoutOrder = 4, Parent = menu })
	hubBtn.Activated:Connect(function()
		HUD.HubRequested:Fire()
	end)

	-- Data binding
	DataController.Observe(function(profile, stats)
		local need = Registry.GameConfig.XPForLevel(profile.Level)
		refs.Level.Text = `Lv.{profile.Level}`
		refs.XPText.Text = `{Format.Number(profile.XP)} / {Format.Number(need)} XP`
		refs.Coins.Text = Format.Number(profile.Coins)
		refs.Gems.Text = Format.Number(profile.Gems)
		local bag = Registry.Equipment.Bags.Items[profile.Equipped.Bags]
		local cap = bag and bag.Capacity or 10
		refs.Bag.Text = `Bag {#profile.Bag}/{cap}`
		refs.Bag.TextColor3 = #profile.Bag >= cap and T.Bad or T.Text
		HUD.RefreshDepthButton()
	end)

	Remotes.Event("Notify").OnClientEvent:Connect(function(text, color)
		HUD.Notify(text, color)
	end)
	Remotes.Event("CatchResult").OnClientEvent:Connect(function(result)
		HUD.ShowCatch(result)
	end)
end

return HUD
]]></ProtectedString>
							<string name="ScriptGuid">{3ED6B8F7-0B4E-4E0B-924E-EE021151978B}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">HUDController</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">7672d16ab309499b0b0c9ea400000404</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="42">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Shop / Auras / Fishdex windows (Figma 05/06, 07, 09). The windows are baked into the place
-- (StarterGui "Menus", built by UI/Screens/Menus); this controller only fills the fixed slots from
-- Config + profile (UI/MenuFill) and drives the pagers. New content shows up automatically (more pages).
-- Add a new window: add its layout to UI/Screens/Menus, a filler to UI/MenuFill + FILLERS, a button in HUDController.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local New = require(script.Parent.Parent.UI.New)
local Baked = require(script.Parent.Parent.UI.Baked)
local MenuFill = require(script.Parent.Parent.UI.MenuFill)
local AuraReel = require(script.Parent.Parent.UI.AuraReel)
local HUD = require(script.Parent.HUDController)
local DataController = require(script.Parent.DataController)

local T = New.Theme

local MenuController = {}

local gui: any = nil
local windows: { [string]: any } = {}
local currentMenu: string? = nil
local pages: { [string]: number } = { Shop = 1, Auras = 1, Fishdex = 1 }
local pageCount: { [string]: number } = { Shop = 1, Auras = 1, Fishdex = 1 }
-- per-slot click handlers (buttons are connected once; the handler changes with the data)
local handlers: { [Instance]: (() -> ())? } = {}

local function invoke(name: string, ...: any)
	local ok, msg = Remotes.Func(name):InvokeServer(...)
	if type(msg) == "string" and msg ~= "OK" then
		HUD.Notify(msg, ok and T.Good or T.Bad)
	end
	return ok, msg
end

local function bindClick(button: GuiButton)
	button.Activated:Connect(function()
		local h = handlers[button]
		if h then
			h()
		end
	end)
end

local FILLERS = {
	Shop = MenuFill.Shop,
	Auras = MenuFill.Auras,
	Fishdex = MenuFill.Fishdex,
}

-- Window plumbing -------------------------------------------------------------------------------

local function ensure()
	if gui then
		return
	end
	gui = Baked.Get("Menus")
	MenuFill.Setup({
		windows = windows,
		pages = pages,
		pageCount = pageCount,
		handlers = handlers,
		currentTab = nil,
		invoke = invoke,
		refresh = function()
			MenuController.Refresh()
		end,
		rollAura = function()
			MenuController.RollAura()
		end,
		setSetting = function(key, value)
			Remotes.Func("SetSetting"):InvokeServer(key, value)
		end,
	})
	for name in FILLERS do
		local w = Baked.Find(gui, name)
		windows[name] = w
		w.Visible = false
		New.FitWindow(w, Vector2.new(760, 610))
		Baked.Find(w, "Header/Close").Activated:Connect(MenuController.Close)
		local pager = w.Footer:FindFirstChild("Pager")
		if pager then
			pager.Prev.Activated:Connect(function()
				if pages[name] > 1 then
					pages[name] -= 1
					MenuController.Refresh()
				end
			end)
			pager.Next.Activated:Connect(function()
				if pages[name] < pageCount[name] then
					pages[name] += 1
					MenuController.Refresh()
				end
			end)
		end
		for _, d in w:GetDescendants() do
			if d:IsA("GuiButton") and d.Name ~= "Close" and d.Name ~= "Prev" and d.Name ~= "Next" then
				bindClick(d)
			end
		end
	end
end

function MenuController.Close()
	if currentMenu and windows[currentMenu] then
		windows[currentMenu].Visible = false
	end
	currentMenu = nil
end

function MenuController.Refresh()
	if not currentMenu then
		return
	end
	local profile = DataController.Profile
	if not profile then
		return
	end
	ensure()
	for name, w in windows do
		w.Visible = name == currentMenu
	end
	FILLERS[currentMenu](profile)
end

function MenuController.Open(name: string)
	if currentMenu == name then
		MenuController.Close()
		return
	end
	if not FILLERS[name] then
		return
	end
	ensure()
	if currentMenu then
		MenuController.Close()
	end
	currentMenu = name
	MenuController.Refresh()
end

-- Roll an aura and play the Reel Slot reveal (Figma: Aura Gacha concept B).
function MenuController.RollAura()
	if AuraReel.IsPlaying() then
		return
	end
	local ok, result, isNew, equipped = Remotes.Func("RollAura"):InvokeServer()
	if not ok then
		HUD.Notify(result, T.Bad)
		return
	end
	MenuController.PlayReveal(result, isNew, equipped)
end

function MenuController.PlayReveal(auraId: string, isNew: boolean?, equipped: boolean?)
	AuraReel.Play(auraId, {
		isNew = isNew,
		equipped = equipped,
		onEquip = function()
			invoke("EquipAura", auraId)
		end,
		onRollAgain = MenuController.RollAura,
	})
end

function MenuController.Init()
	Remotes.Event("AuraRolled").OnClientEvent:Connect(function(auraId, isNew, equipped)
		MenuController.PlayReveal(auraId, isNew, equipped)
	end)
	HUD.MenuRequested:Connect(MenuController.Open)
	DataController.Changed:Connect(function()
		MenuController.Refresh()
	end)
	task.spawn(ensure) -- find the baked screen early so the first open is instant
end

return MenuController
]]></ProtectedString>
							<string name="ScriptGuid">{B8E7271F-9116-429E-9B5C-EAD0B8D02829}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">MenuController</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">7672d16ab309499b0b0c9ea400000405</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX69ECE0744E4F4E9EBB92799EEEA4D569">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Main Menu hub (Figma 12). Screen is baked in StarterGui "MainMenu" (UI/Screens/MainMenu); this
-- controller opens/closes it, keeps the clock/day phase/avatar live and routes tiles:
-- Shop/Auras/Fishdex open their windows; features not built yet show "coming soon".
-- Red dots: Auras = enough gems to roll. Badges: none yet (SALE / Lv.100 come with those systems).

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared.Registry)

local New = require(script.Parent.Parent.UI.New)
local Baked = require(script.Parent.Parent.UI.Baked)
local HUD = require(script.Parent.HUDController)
local DataController = require(script.Parent.DataController)

local T = New.Theme
local WHITE = Color3.new(1, 1, 1)

local MainMenuController = {}

local gui: any = nil
local refs: any = {}

-- Tile id -> menu window name in MenuController (others are not built yet)
local OPENS = { Shop = "Shop", Auras = "Auras", Fishdex = "Fishdex" }

local function phaseFor(clock: number): string
	if clock >= 5 and clock < 7.5 then
		return "Dawn"
	elseif clock >= 7.5 and clock < 17.5 then
		return "Day"
	elseif clock >= 17.5 and clock < 20 then
		return "Dusk"
	end
	return "Night"
end

local function refreshClock()
	if not gui then
		return
	end
	local c = Lighting.ClockTime
	refs.Clock.Text = string.format("%02d:%02d", math.floor(c) % 24, math.floor((c % 1) * 60))
	local now = phaseFor(c)
	for _, holder in refs.DayPhase:GetChildren() do
		if holder:IsA("Frame") then
			local current = holder.Name == now
			holder.BackgroundTransparency = if current then 0 else 1
			holder.Size = UDim2.fromOffset(if current then 36 else holder.Icon.Size.X.Offset, 22)
			holder.Icon.ImageColor3 = if current then T.SkyLip else WHITE
			holder.Icon.ImageTransparency = if holder.Name == "Dusk" and not current then 0.25 else 0
		end
	end
	-- re-flow: current pill is wider than the plain icons
	local x = 0
	for _, name in { "Night", "Dawn", "Day", "Dusk" } do
		local h = refs.DayPhase:FindFirstChild(name)
		if h then
			h.Position = UDim2.fromOffset(x, 0)
			x += h.Size.X.Offset + 8
		end
	end
end

local function refreshData(profile: any)
	if not gui or not profile then
		return
	end
	local canRoll = profile[Registry.GameConfig.AuraRollCurrency] >= Registry.GameConfig.AuraRollCost
	refs.Tiles.Auras.Dot.Visible = canRoll
end

local function ensure()
	if gui then
		return
	end
	gui = Baked.Get("MainMenu")
	local hub = Baked.Find(gui, "Hub")
	refs.Hub = hub
	refs.Clock = Baked.Find(hub, "Glass/Phone/Header/Clock")
	refs.DayPhase = Baked.Find(hub, "Glass/Phone/Header/DayPhase")
	refs.Avatar = Baked.Find(hub, "Glass/Phone/Header/Avatar")
	refs.Tiles = {}
	for _, t in Baked.Find(hub, "Glass/Phone/Grid"):GetChildren() do
		if t:IsA("GuiButton") then
			refs.Tiles[t.Name] = t
			t.Activated:Connect(function()
				MainMenuController.Close()
				local menu = OPENS[t.Name]
				if menu then
					HUD.MenuRequested:Fire(menu)
				else
					HUD.Notify(`{t.Name}: coming soon!`, T.SubText)
				end
			end)
		end
	end
	Baked.Find(hub, "Close").Activated:Connect(MainMenuController.Close)
	New.FitWindow(hub, Vector2.new(440, 614))

	-- player's headshot in the avatar circle (falls back to the Pip art / cream circle)
	task.spawn(function()
		local ok, id = pcall(function()
			return Players:GetUserThumbnailAsync(Players.LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
		end)
		if ok and id then
			refs.Avatar:SetAttribute("ImageKey", nil)
			refs.Avatar.Image = id
			local fb = refs.Avatar:FindFirstChild("Fallback")
			if fb then
				fb.Visible = false
			end
		end
	end)
	Lighting:GetPropertyChangedSignal("ClockTime"):Connect(refreshClock)
end

function MainMenuController.IsOpen(): boolean
	return gui ~= nil and gui.Enabled
end

function MainMenuController.Open()
	ensure()
	refreshClock()
	refreshData(DataController.Profile)
	gui.Enabled = true
end

function MainMenuController.Close()
	if gui then
		gui.Enabled = false
	end
end

function MainMenuController.Toggle()
	if MainMenuController.IsOpen() then
		MainMenuController.Close()
	else
		MainMenuController.Open()
	end
end

function MainMenuController.Init()
	HUD.HubRequested:Connect(MainMenuController.Toggle)
	DataController.Changed:Connect(function()
		refreshData(DataController.Profile)
	end)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.M then
			MainMenuController.Toggle()
		end
	end)
	task.spawn(ensure)
end

return MainMenuController
]]></ProtectedString>
							<string name="ScriptGuid">{1B49F32D-2C19-4B72-A1D9-522C9DE70EF2}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">MainMenuController</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">00a66f3622ca00970b0cab0c00001b9d</UniqueId>
						</Properties>
					</Item>
				</Item>
				<Item class="LocalScript" referent="43">
					<Properties>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Client bootstrap. Controllers are ModuleScripts with Init(); add new ones to ORDER.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Remotes = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Remotes"))
local Controllers = script.Parent:WaitForChild("Controllers")

local ORDER: { ModuleScript } = {
	Controllers.DataController,
	Controllers.HUDController,
	Controllers.FishingController,
	Controllers.MenuController,
	Controllers.MainMenuController,
	Controllers.AuraFXController,
}

for _, module in ORDER do
	local controller = require(module) :: any
	if controller.Init then
		controller.Init()
	end
end

Remotes.Event("ClientReady"):FireServer()
]]></ProtectedString>
