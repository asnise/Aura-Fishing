				</Item>
				<Item class="ModuleScript" referent="8">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Fish catalogue. Add a fish = add one entry. Registry validates every entry at startup
-- (unknown rarity/pattern/location or bad depth range = clear error in Output).
--
-- DepthMin/DepthMax : metres. A fish can bite only when the player's target depth is inside.
-- BaseValue         : coins at average weight, before mutation/manual/sell multipliers.
-- Weight            : {min, max} kg. Heavier than average = worth more.
-- Difficulty        : 1..10, drives minigame speed.
-- Pattern           : movement style key in Config/MinigamePatterns.
-- Locations         : optional list of Location ids; nil = any location.
-- RollWeight        : optional, overrides the rarity's base weight for this fish.

export type FishDef = {
	Name: string,
	Rarity: string,
	DepthMin: number,
	DepthMax: number,
	BaseValue: number,
	Weight: { number },
	Difficulty: number,
	Pattern: string,
	Locations: { string }?,
	RollWeight: number?,
	Description: string?,
}

local Fish: { [string]: FishDef } = {
	-- Shallow 0-50m
	PebbleMinnow = { Name = "Pebble Minnow", Rarity = "Common", DepthMin = 0, DepthMax = 40, BaseValue = 4, Weight = { 0.1, 0.4 }, Difficulty = 1, Pattern = "Calm" },
	BubbleCarp = { Name = "Bubble Carp", Rarity = "Common", DepthMin = 0, DepthMax = 50, BaseValue = 6, Weight = { 0.8, 3 }, Difficulty = 1, Pattern = "Calm" },
	ReedPerch = { Name = "Reed Perch", Rarity = "Common", DepthMin = 5, DepthMax = 60, BaseValue = 8, Weight = { 0.4, 1.6 }, Difficulty = 2, Pattern = "Calm" },
	SunScaleSardine = { Name = "Sunscale Sardine", Rarity = "Common", DepthMin = 0, DepthMax = 30, BaseValue = 5, Weight = { 0.1, 0.3 }, Difficulty = 2, Pattern = "Darting" },
	PearlClam = { Name = "Pearl Clam", Rarity = "Uncommon", DepthMin = 10, DepthMax = 50, BaseValue = 22, Weight = { 0.2, 0.8 }, Difficulty = 1, Pattern = "Sinker" },
	LilyTrout = { Name = "Lily Trout", Rarity = "Uncommon", DepthMin = 0, DepthMax = 45, BaseValue = 18, Weight = { 1, 4 }, Difficulty = 3, Pattern = "Darting" },
	DewdropKoi = { Name = "Dewdrop Koi", Rarity = "Rare", DepthMin = 0, DepthMax = 35, BaseValue = 70, Weight = { 2, 6 }, Difficulty = 4, Pattern = "Erratic" },
	CrystalGuppy = { Name = "Crystal Guppy", Rarity = "Epic", DepthMin = 0, DepthMax = 50, BaseValue = 240, Weight = { 0.1, 0.2 }, Difficulty = 6, Pattern = "Darting" },

	-- Mid 51-200m
	StripeBass = { Name = "Stripe Bass", Rarity = "Common", DepthMin = 40, DepthMax = 140, BaseValue = 14, Weight = { 2, 7 }, Difficulty = 2, Pattern = "Calm" },
	TideSnapper = { Name = "Tide Snapper", Rarity = "Common", DepthMin = 50, DepthMax = 160, BaseValue = 16, Weight = { 1.5, 5 }, Difficulty = 3, Pattern = "Darting" },
	ArmoredCrab = { Name = "Armored Crab", Rarity = "Uncommon", DepthMin = 60, DepthMax = 120, BaseValue = 34, Weight = { 1, 4 }, Difficulty = 3, Pattern = "Sinker" },
	SilverRay = { Name = "Silver Ray", Rarity = "Uncommon", DepthMin = 70, DepthMax = 200, BaseValue = 40, Weight = { 5, 20 }, Difficulty = 4, Pattern = "Calm" },
	RazorPike = { Name = "Razor Pike", Rarity = "Rare", DepthMin = 60, DepthMax = 180, BaseValue = 110, Weight = { 4, 12 }, Difficulty = 5, Pattern = "Darting" },
	MoonJelly = { Name = "Moon Jelly", Rarity = "Rare", DepthMin = 80, DepthMax = 200, BaseValue = 95, Weight = { 0.5, 2 }, Difficulty = 4, Pattern = "Erratic" },
	EmberTuna = { Name = "Ember Tuna", Rarity = "Epic", DepthMin = 100, DepthMax = 200, BaseValue = 420, Weight = { 30, 90 }, Difficulty = 7, Pattern = "Erratic" },
	CoralSeahorse = { Name = "Coral Seahorse", Rarity = "Legendary", DepthMin = 50, DepthMax = 150, BaseValue = 1500, Weight = { 0.1, 0.3 }, Difficulty = 8, Pattern = "Erratic" },

	-- Deep 201m+ (needs line upgrades)
	LanternAngler = { Name = "Lantern Angler", Rarity = "Uncommon", DepthMin = 200, DepthMax = 400, BaseValue = 90, Weight = { 2, 8 }, Difficulty = 5, Pattern = "Sinker" },
	GlowEel = { Name = "Glow Eel", Rarity = "Rare", DepthMin = 220, DepthMax = 500, BaseValue = 260, Weight = { 3, 10 }, Difficulty = 6, Pattern = "Darting" },
	AncientCoelacanth = { Name = "Ancient Coelacanth", Rarity = "Legendary", DepthMin = 250, DepthMax = 600, BaseValue = 3200, Weight = { 40, 90 }, Difficulty = 8, Pattern = "Sinker" },
	NagaHatchling = { Name = "Naga Hatchling", Rarity = "Mythic", DepthMin = 200, DepthMax = 300, BaseValue = 12000, Weight = { 5, 15 }, Difficulty = 9, Pattern = "Erratic", Description = "A young serpent of the river. Its parent still sleeps below." },
}

return Fish
]]></ProtectedString>
						<string name="ScriptGuid">{059E31F8-7CAC-4B5B-BFB2-F0404655DF15}</string>
