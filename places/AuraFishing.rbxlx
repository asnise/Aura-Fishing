					<Item class="ModuleScript" referent="RBX15AF8B841162433F88516DB121A16A50">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Generic confirm modal (Figma 14). Screen is baked in StarterGui ("Modal"); this module only binds it.
--   Modal.Confirm({ Title = "Sell all 18 fish?", Message = "...", ConfirmText = "Sell", ConfirmColor = New.Theme.Gold,
--                   Icon = "ui/status/sell_bag" }, function() ... end)

local New = require(script.Parent.New)
local Baked = require(script.Parent.Baked)
local T = New.Theme

local Modal = {}

local gui: any = nil
local refs: any = nil
local pending: (() -> ())? = nil

local function ensure()
	if gui then
		return
	end
	gui = Baked.Get("Modal")
	local g = gui :: ScreenGui
	refs = {
		Dim = Baked.Find(g, "Dim"),
		Window = Baked.Find(g, "Window"),
		Icon = Baked.Find(g, "Window/Body/Icon"),
		Title = Baked.Find(g, "Window/Body/Title"),
		Message = Baked.Find(g, "Window/Body/Message"),
		Cancel = Baked.Find(g, "Window/Footer/Cancel"),
		Confirm = Baked.Find(g, "Window/Footer/Confirm"),
	}
	New.FitWindow(refs.Window, Vector2.new(600, 349))
	refs.Cancel.Activated:Connect(Modal.Close)
	refs.Dim.Activated:Connect(Modal.Close)
	refs.Confirm.Activated:Connect(function()
		local cb = pending
		Modal.Close()
		if cb then
			cb()
		end
	end)
end

function Modal.Close()
	pending = nil
	if gui then
		gui.Enabled = false
	end
end

function Modal.IsOpen(): boolean
	return gui ~= nil and (gui :: ScreenGui).Enabled
end

function Modal.Confirm(opts: { [string]: any }, onConfirm: () -> ())
	ensure()
	refs.Title.Text = opts.Title or "Are you sure?"
	refs.Message.Text = opts.Message or ""
	refs.Confirm.Text = opts.ConfirmText or "Confirm"
	refs.Cancel.Text = opts.CancelText or "Cancel"
	New.SetButtonColor(refs.Confirm, opts.ConfirmColor or T.Good)
	refs.Icon.Visible = opts.Icon ~= false
	if type(opts.Icon) == "string" then
		New.SetImageKey(refs.Icon, opts.Icon, opts.IconColor, opts.IconText)
	end
	pending = onConfirm;
	(gui :: any).Enabled = true
end

return Modal
]]></ProtectedString>
							<string name="ScriptGuid">{E756772E-26F6-4A71-A64A-3A10AAC4FF6F}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Modal</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">00a66f3622ca00970b0cab0c00000ba5</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBXAA13580BEA634B5295CAD2CCFF350117">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Screens are stored in the place (StarterGui), not created when the game starts.
--   * Each screen has a builder in UI/Screens/<Name>.luau: { Name = "Modal", Build = function(): ScreenGui }.
--   * `node tools/ui/bake.mjs [Name ...]` runs the builders inside Studio (StudioBridge) and puts the
--     ScreenGuis into StarterGui. Save the place afterwards. Hand-edit them in Studio freely; set the
--     ScreenGui attribute Locked = true so a later bake skips it.
--   * At runtime controllers call Baked.Get(name) to find their ScreenGui in PlayerGui and bind data.
--     Only if the place has no baked copy (e.g. a fresh `rojo build`) is the screen built here, with a warning.

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")

local New = require(script.Parent.New)
local Screens = script.Parent.Screens

local Baked = {}

function Baked.Get(name: string): ScreenGui
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local gui = playerGui:FindFirstChild(name)
	if not gui and StarterGui:FindFirstChild(name) then
		-- baked: Roblox copies StarterGui into PlayerGui when the character spawns
		gui = playerGui:WaitForChild(name, 15)
	end
	if not gui then
		warn(`[UI] ScreenGui "{name}" is not baked into StarterGui; building it at runtime. Run: node tools/ui/bake.mjs {name}`)
		local screen = require(Screens:WaitForChild(name)) :: any
		gui = screen.Build()
		gui.Parent = playerGui
	end
	New.ApplyImages(gui)
	return gui :: ScreenGui
end

-- Find a descendant by slash path ("Window/Footer/Confirm"); errors with the exact missing part.
function Baked.Find(root: Instance, path: string): any
	local cur = root
	for part in string.gmatch(path, "[^/]+") do
		local nxt = cur:FindFirstChild(part)
		if not nxt then
			error(`[UI] {root.Name}: missing "{part}" in "{path}" (re-bake the screen or fix the name in Studio)`, 2)
		end
		cur = nxt
	end
	return cur
end

return Baked
]]></ProtectedString>
							<string name="ScriptGuid">{E47388CC-C83D-43CB-8F23-B8CFB255A192}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
							<bool name="DefinesCapabilities">false</bool>
							<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
							<string name="Name">Baked</string>
							<BinaryString name="SerializedOverrides"></BinaryString>
							<int64 name="SourceAssetId">-1</int64>
							<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
							<UniqueId name="UniqueId">00a66f3622ca00970b0cab0c00000ba7</UniqueId>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX31F3947E90AA404CADA1A4BC2CAB4228">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Fills the baked "Menus" screen (UI/Screens/Menus) from Config + a profile: Shop (Figma 05/06),
-- Auras (07, Aura Card Row), Fishdex (09, 3x2 cards). No network/player access, so it also runs in
-- Studio edit mode (tools/ui/preview.mjs fills the windows with Figma's sample data for comparisons).
-- MenuController owns the context (window refs, pages, click handlers, server calls).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared.Registry)
local Format = require(Shared.Util.Format)

local New = require(script.Parent.New)
local MenusScreen = require(script.Parent.Screens.Menus)

local T = New.Theme

local MenuFill = {}

-- ctx = { windows = {Shop=, Auras=, Fishdex=}, pages = {}, pageCount = {}, handlers = {},
--         currentTab = string?, invoke(name, ...), refresh(), rollAura(), setSetting(key, value) }
local ctx: any = nil

function MenuFill.Setup(context: any)
	ctx = context
end

-- Set a button's text/colour/handler; nil handler = inactive (no hover, no click).
local function setButton(button: any, text: string, color: Color3, handler: (() -> ())?)
	button.Visible = true
	button.Text = text
	New.SetButtonColor(button, color)
	button.AutoButtonColor = handler ~= nil
	ctx.handlers[button] = handler
end

local function statBadges(stats: { [string]: number }?, mutations: { [string]: number }?): { any }
	local out = {}
	if stats then
		local keys = {}
		for k in stats do
			table.insert(keys, k)
		end
		table.sort(keys)
		for _, k in keys do
			local def = Registry.StatDefs[k]
			local v = stats[k]
			if def.Percent then
				table.insert(out, { Text = `{Format.Percent(v)} {def.Display}` })
			elseif k == "MaxDepth" then
				table.insert(out, { Text = `{v}m depth` })
			else
				table.insert(out, { Text = string.format("+%.2f %s", v, def.Display) })
			end
		end
	end
	if mutations then
		for m, v in mutations do
			local mut = Registry.Mutations[m]
			table.insert(out, { Text = `{Format.Percent(v)} {mut.Name}`, Color = mut.Color })
		end
	end
	return out
end

local function statsText(stats: { [string]: number }?): string
	local parts = {}
	for _, b in statBadges(stats) do
		table.insert(parts, b.Text)
	end
	return table.concat(parts, ", ")
end

local function initial(name: string): string
	return string.upper(string.sub(name, 1, 1))
end

local function setPager(menu: string, total: number, perPage: number)
	local count = math.max(1, math.ceil(total / perPage))
	ctx.pageCount[menu] = count
	ctx.pages[menu] = math.clamp(ctx.pages[menu], 1, count)
	local pager = ctx.windows[menu].Footer:FindFirstChild("Pager")
	if pager then
		pager.Label.Text = `{ctx.pages[menu]} / {count}`
		pager.Prev.AutoButtonColor = ctx.pages[menu] > 1
		pager.Next.AutoButtonColor = ctx.pages[menu] < count
	end
	return (ctx.pages[menu] - 1) * perPage
end

local function setWallet(menu: string, profile: any)
	local wallet = ctx.windows[menu].Footer:FindFirstChild("Wallet")
	if not wallet then
		return
	end
	for _, cur in { "Coins", "Gems" } do
		local c = wallet:FindFirstChild(cur)
		if c then
			c.Value.Text = Format.Number(profile[cur])
		end
	end
end

-- Shop (Figma 05/06) ---------------------------------------------------------------------------

local function shopCategories(): { string }
	local cats = {}
	for id in Registry.Equipment do
		table.insert(cats, id)
	end
	table.sort(cats)
	return cats
end

local function fillShop(profile: any)
	local w = ctx.windows.Shop
	local cats = shopCategories()
	ctx.currentTab = if ctx.currentTab and Registry.Equipment[ctx.currentTab] then ctx.currentTab else cats[1]

	local tabs = w.Tabs
	local shown = 0
	for i = 1, 6 do
		local tab = tabs:FindFirstChild("Tab" .. i)
		if not tab then
			continue
		end
		local id = cats[i]
		tab.Visible = id ~= nil
		if id then
			shown += 1
			tab.Text = Registry.Equipment[id].DisplayName
			New.SetButtonColor(tab, if id == ctx.currentTab then T.Accent else T.PanelLight)
			ctx.handlers[tab] = function()
				if ctx.currentTab ~= id then
					ctx.currentTab = id
					ctx.pages.Shop = 1
					ctx.refresh()
				end
			end
		end
	end
	if #cats > 6 then
		warn(`[Shop] {#cats} categories but only 6 tab slots in the baked Menus screen`)
	end
	for i = 1, shown do
		tabs["Tab" .. i].Size = UDim2.new(1 / shown, -8 * (shown - 1) / shown, 1, 0)
	end

	local catId = ctx.currentTab :: string
	local cat = Registry.Equipment[catId]
	local items = Registry.SortedItems(catId)
	local offset = setPager("Shop", #items, MenusScreen.ShopRows)
	w.List.Empty.Visible = #items == 0

	for slot = 1, MenusScreen.ShopRows do
		local row = w.List:FindFirstChild("Row" .. slot)
		if not row then
			continue
		end
		local itemId = items[offset + slot]
		row.Visible = itemId ~= nil
		if not itemId then
			continue
		end
		local item = cat.Items[itemId]
		New.SetImageKey(row.Picture, `equipment/{itemId}`, T.Track, initial(item.Name))
		local sub = statsText(item.Stats)
		if item.Capacity then
			sub = `Holds {item.Capacity} fish` .. (if sub ~= "" then ", " .. sub else "")
		end
		if sub == "" then
			sub = item.Description or ""
		end
		local price = if item.Price == 0 then "Free" else `{Format.Number(item.Price)} {item.Currency}`
		local equipped = profile.Equipped[catId] == itemId
		local title = row.Top.Title
		title.TextColor3 = T.Text
		row.Use.Visible = false
		ctx.handlers[row.Use] = nil

		if cat.Kind == "Permanent" then
			local owned = profile.Owned[catId][itemId]
			title.Text = item.Name
			row.Sub.Text = sub
			if equipped then
				setButton(row.Action, "Equipped", T.Good, nil)
			elseif owned then
				setButton(row.Action, "Equip", T.Sky, function()
					ctx.invoke("Equip", catId, itemId)
				end)
			elseif item.RequiredLevel and profile.Level < item.RequiredLevel then
				title.TextColor3 = T.SubText
				row.Sub.Text = sub .. "  |  " .. price
				setButton(row.Action, `Lv. {item.RequiredLevel}`, T.PanelLight, nil)
			else
				row.Sub.Text = sub .. "  |  " .. price
				local afford = profile[item.Currency] >= item.Price
				setButton(row.Action, "Buy", if afford then T.Gold else T.PanelLight, function()
					ctx.invoke("Buy", catId, itemId)
				end)
			end
		else
			local count = profile.Consumables[catId][itemId] or 0
			title.Text = `{item.Name}  x{count}` .. (if equipped then "  (equipped)" else "")
			title.TextColor3 = if equipped then T.GoodLip else T.Text
			row.Sub.Text = sub .. "  |  " .. `{item.BuyAmount} for {price}`
			setButton(row.Action, `Buy x{item.BuyAmount}`, T.Gold, function()
				ctx.invoke("Buy", catId, itemId)
			end)
			if count > 0 and not equipped then
				setButton(row.Use, "Use", T.Sky, function()
					ctx.invoke("Equip", catId, itemId)
				end)
			end
		end
	end
	setWallet("Shop", profile)
end

-- Auras (Figma 07, Aura Card Row) --------------------------------------------------------------

local function fillAuraCard(card: any, id: string, profile: any)
	local a = Registry.Auras[id]
	local rarity = Registry.Rarities[a.Rarity]
	local owned = profile.Auras.Owned[id] or 0
	local known = owned > 0
	New.SetImageKey(card.Picture, if known then `auras/{id}` else "auras/UnknownAura", if known then a.Visual.Color[1] else T.Track, if known then "" else "?")
	card.Top.Title.Text = if known then a.Name else "???"
	card.Top.Title.TextColor3 = rarity.Color
	New.SetBadges(card.Top.Tags, {
		{ Text = string.upper(rarity.Name), Color = rarity.Color },
		{ Text = Format.Chance(a.Chance), Color = T.SubText },
	})
	New.SetBadges(card.Badges, if known then statBadges(a.Stats, a.Mutations) else {})
	return known, owned
end

local function fillAuras(profile: any)
	local w = ctx.windows.Auras
	local cost = Registry.GameConfig.AuraRollCost
	local currency = Registry.GameConfig.AuraRollCurrency
	setButton(w.Top.Roll, `ROLL AURA  ({cost} {currency})`, T.Gem, ctx.rollAura)
	setButton(w.Top.LowFX, if profile.Settings.LowFX then "Low FX: ON" else "Low FX: OFF", T.PanelLight, function()
		ctx.setSetting("LowFX", not profile.Settings.LowFX)
	end)

	-- equipped card
	local eq = w.Equipped
	eq.Visible = true
	local equippedId = profile.Auras.Equipped
	local has = equippedId ~= nil and Registry.Auras[equippedId] ~= nil
	eq.None.Visible = not has
	eq.Top.Visible = has
	eq.Badges.Visible = has
	eq.Status.Visible = has
	if has then
		fillAuraCard(eq, equippedId, profile)
	else
		New.SetImageKey(eq.Picture, "auras/UnknownAura", T.Track, "?")
	end

	local ids = Registry.SortedAuras()
	local offset = setPager("Auras", #ids, MenusScreen.AuraRows)
	for slot = 1, MenusScreen.AuraRows do
		local row = w.List:FindFirstChild("Row" .. slot)
		if not row then
			continue
		end
		local id = ids[offset + slot]
		row.Visible = id ~= nil
		if not id then
			continue
		end
		local known, owned = fillAuraCard(row, id, profile)
		row.Status.Visible = true
		row.Status.Text = if known then `x{owned}` else "-"
		if profile.Auras.Equipped == id then
			setButton(row.Action, "Unequip", T.Good, function()
				ctx.invoke("EquipAura", nil)
			end)
		elseif known then
			setButton(row.Action, "Equip", T.Sky, function()
				ctx.invoke("EquipAura", id)
			end)
		else
			row.Action.Visible = false
			ctx.handlers[row.Action] = nil
		end
	end
	setWallet("Auras", profile)
end

-- Fishdex (Figma 09, 3x2 cards) ----------------------------------------------------------------

local function fillFishdex(profile: any)
	local w = ctx.windows.Fishdex
	local ids = {}
	for id in Registry.Fish do
		table.insert(ids, id)
	end
	table.sort(ids, function(a, b)
		local fa, fb = Registry.Fish[a], Registry.Fish[b]
		if fa.DepthMin ~= fb.DepthMin then
			return fa.DepthMin < fb.DepthMin
		end
		return a < b
	end)
	local found = 0
	for _ in profile.Fishdex do
		found += 1
	end
	w.Summary.Count.Text = `Discovered {found} / {#ids}`
	w.Summary.Progress.Fill.Size = UDim2.fromScale(if #ids > 0 then found / #ids else 0, 1)

	local offset = setPager("Fishdex", #ids, MenusScreen.DexCards)
	for slot = 1, MenusScreen.DexCards do
		local card = w.Grid:FindFirstChild("Card" .. slot)
		if not card then
			continue
		end
		local id = ids[offset + slot]
		card.Visible = id ~= nil
		if not id then
			continue
		end
		local f = Registry.Fish[id]
		local r = Registry.Rarities[f.Rarity]
		local dex = profile.Fishdex[id]
		New.SetImageKey(card.Picture.Image, if dex then `fish/{id}` else "fish/MysteryFish", if dex then r.Color else T.Track, if dex then initial(f.Name) else "?")
		card.FishName.Text = if dex then f.Name else "???"
		card.FishName.TextColor3 = if dex then T.Text else T.SubText
		New.SetBadges(card.Where, {
			{ Text = string.upper(r.Name), Color = r.Color },
			{ Text = `{f.DepthMin}-{f.DepthMax}m`, Color = T.Sky },
		})
		New.SetBadges(
			card.Record,
			if dex then { { Text = `Caught x{dex.Count}` }, { Text = string.format("Best %.2f kg", dex.Best) } } else { { Text = "Not caught yet" } }
		)
	end
end

MenuFill.Shop = fillShop
MenuFill.Auras = fillAuras
MenuFill.Fishdex = fillFishdex

return MenuFill
]]></ProtectedString>
