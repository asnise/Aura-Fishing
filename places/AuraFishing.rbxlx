				<Item class="ModuleScript" referent="7">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Shop equipment. Every category uses the same shape so the shop UI and ShopService
-- handle new categories/items automatically.
--
-- Rods / Lines / Bags : permanent purchases, one equipped per category.
-- Baits               : consumable stacks (BuyAmount per purchase), one bait slot equipped,
--                       one unit consumed per successful catch.
-- Order               : sort order in the shop; first item (Price = 0) is the starter item.
-- Stats               : additive stat bonuses (see StatDefs).

export type Item = {
	Name: string,
	Price: number,
	Currency: string, -- "Coins" | "Gems"
	Order: number,
	Stats: { [string]: number },
	Description: string?,
	Capacity: number?, -- Bags only
	BuyAmount: number?, -- Baits only
	RequiredLevel: number?,
}

export type Category = {
	DisplayName: string,
	Kind: string, -- "Permanent" | "Consumable"
	Items: { [string]: Item },
}

local Equipment: { [string]: Category } = {
	Rods = {
		DisplayName = "Rods",
		Kind = "Permanent",
		Items = {
			DriftwoodRod = { Name = "Driftwood Rod", Price = 0, Currency = "Coins", Order = 1, Stats = {} },
			BambooRod = { Name = "Bamboo Rod", Price = 400, Currency = "Coins", Order = 2, Stats = { CatchBarSize = 0.03, ReelPower = 0.15, Luck = 0.05 } },
			CoralRod = { Name = "Coral Rod", Price = 2500, Currency = "Coins", Order = 3, Stats = { CatchBarSize = 0.05, ReelPower = 0.3, Resilience = 0.15, Luck = 0.15 } },
			MoonsilverRod = { Name = "Moonsilver Rod", Price = 15000, Currency = "Coins", Order = 4, RequiredLevel = 10, Stats = { CatchBarSize = 0.08, ReelPower = 0.5, Resilience = 0.3, Luck = 0.35, FishStability = 0.1 } },
			NagaScaleRod = { Name = "Naga Scale Rod", Price = 90000, Currency = "Coins", Order = 5, RequiredLevel = 25, Stats = { CatchBarSize = 0.12, ReelPower = 0.8, Resilience = 0.45, Luck = 0.75, FishStability = 0.2, MutationChance = 0.02 } },
		},
	},
	Lines = {
		DisplayName = "Lines",
		Kind = "Permanent",
		Items = {
			CottonLine = { Name = "Cotton Line (30m)", Price = 0, Currency = "Coins", Order = 1, Stats = { MaxDepth = 30 } },
			HempLine = { Name = "Hemp Line (80m)", Price = 300, Currency = "Coins", Order = 2, Stats = { MaxDepth = 80 } },
			NylonLine = { Name = "Nylon Line (150m)", Price = 1800, Currency = "Coins", Order = 3, Stats = { MaxDepth = 150, Resilience = 0.05 } },
			SilkLine = { Name = "Spider-Silk Line (300m)", Price = 9000, Currency = "Coins", Order = 4, Stats = { MaxDepth = 300, Resilience = 0.1 } },
		},
	},
	Bags = {
		DisplayName = "Bags",
		Kind = "Permanent",
		Items = {
			StarterPouch = { Name = "Starter Pouch", Price = 0, Currency = "Coins", Order = 1, Capacity = 10, Stats = {} },
			WovenBasket = { Name = "Woven Basket", Price = 250, Currency = "Coins", Order = 2, Capacity = 25, Stats = {} },
			Crate = { Name = "Fish Crate", Price = 1500, Currency = "Coins", Order = 3, Capacity = 50, Stats = {} },
			Coolbox = { Name = "Ice Coolbox", Price = 8000, Currency = "Coins", Order = 4, Capacity = 100, Stats = {} },
			Hold = { Name = "Ship's Hold", Price = 40000, Currency = "Coins", Order = 5, Capacity = 250, Stats = {} },
		},
	},
	Baits = {
		DisplayName = "Baits",
		Kind = "Consumable",
		Items = {
			Worm = { Name = "Worm", Price = 20, Currency = "Coins", Order = 1, BuyAmount = 10, Stats = { Luck = 0.1 } },
			Shrimp = { Name = "Shrimp", Price = 150, Currency = "Coins", Order = 2, BuyAmount = 10, Stats = { Luck = 0.3, BiteSpeed = 0.1 } },
			GlowGrub = { Name = "Glow Grub", Price = 900, Currency = "Coins", Order = 3, BuyAmount = 10, Stats = { Luck = 0.75, MutationChance = 0.01 } },
		},
	},
}

return Equipment
]]></ProtectedString>
						<string name="ScriptGuid">{51E4A609-6815-4E14-B79A-C096D1DE03E5}</string>
