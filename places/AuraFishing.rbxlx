					</Properties>
				</Item>
				<Item class="ModuleScript" referent="10">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Fishing locations. In the world, a location is one or more Parts tagged "FishingZone"
-- with attribute LocationId = <key>. Fish may restrict themselves with `Locations = {...}`.
-- To add an island/lake: build it, drop a FishingZone part over its water, add an entry here.

export type Location = {
	Name: string,
	MaxDepth: number, -- physical depth of this water; caps the depth slider
	LuckBonus: number?,
}

local Locations: { [string]: Location } = {
	StarterBay = { Name = "Starter Bay", MaxDepth = 300 },
}

return Locations
]]></ProtectedString>
						<string name="ScriptGuid">{2B775DD0-0B58-4A94-AED4-EC2666A4DD88}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Locations</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">7672d16ab309499b0b0c9ea4000003e7</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="11">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Fish movement styles for the reel minigame. The client uses these to move the fish icon.
-- Speed:   base movement speed (bar heights / second) at Difficulty 1. Scales with difficulty.
-- Jitter:  chance per second to pick a new target position.
-- Bias:    preferred bar position (0 = bottom, 1 = top) or nil for none.
-- BurstChance: chance per second of a fast dash (for Erratic fish).

export type Pattern = { Speed: number, Jitter: number, Bias: number?, BurstChance: number }

local MinigamePatterns: { [string]: Pattern } = {
	Calm = { Speed = 0.25, Jitter = 0.6, Bias = nil, BurstChance = 0 },
	Darting = { Speed = 0.45, Jitter = 1.4, Bias = nil, BurstChance = 0.15 },
	Sinker = { Speed = 0.3, Jitter = 0.8, Bias = 0.15, BurstChance = 0.05 },
	Erratic = { Speed = 0.55, Jitter = 2.0, Bias = nil, BurstChance = 0.4 },
}

return MinigamePatterns
]]></ProtectedString>
						<string name="ScriptGuid">{6D2EA676-D7D8-49B2-BF19-9C790D1A2B5E}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">MinigamePatterns</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">7672d16ab309499b0b0c9ea4000003e8</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="12">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Fish mutations (GDD 5.3). On every catch each mutation is checked in Priority order
-- (highest first); the first that succeeds is applied. Chance = BaseChance + MutationChance stat
-- + aura-specific bonus for this mutation id.

export type MutationDef = {
	Name: string,
	ValueMultiplier: number,
	BaseChance: number,
	Priority: number,
	Color: Color3,
}

local Mutations: { [string]: MutationDef } = {
	Glowing = { Name = "Glowing", ValueMultiplier = 1.8, BaseChance = 0.02, Priority = 1, Color = Color3.fromRGB(60, 196, 176) },
	SunForged = { Name = "Sun-Forged", ValueMultiplier = 2.5, BaseChance = 0, Priority = 2, Color = Color3.fromRGB(242, 140, 56) },
	Golden = { Name = "Golden", ValueMultiplier = 3.0, BaseChance = 0.005, Priority = 3, Color = Color3.fromRGB(224, 168, 46) },
	VoidTouched = { Name = "Void-Touched", ValueMultiplier = 5.0, BaseChance = 0, Priority = 4, Color = Color3.fromRGB(138, 92, 200) },
}

return Mutations
]]></ProtectedString>
						<string name="ScriptGuid">{C2612E34-FF21-42CC-9ACC-DED26D241E7E}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Mutations</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">7672d16ab309499b0b0c9ea4000003e9</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="13">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Rarity tiers. `Tier` drives how strongly Luck boosts the tier (higher tier = more luck benefit).
-- `Weight` is the base roll weight for fish of this rarity (before luck).
-- Colours follow docs/UI_STYLE.md (Cozy Lake): readable on cream panels.
-- To add a tier: add an entry with a unique Tier number. Fish reference rarities by key.

export type Rarity = {
	Name: string,
	Tier: number,
	Weight: number,
	Color: Color3,
	XP: number,
}

local Rarities: { [string]: Rarity } = {
	Common = { Name = "Common", Tier = 1, Weight = 1000, Color = Color3.fromRGB(154, 165, 177), XP = 5 },
	Uncommon = { Name = "Uncommon", Tier = 2, Weight = 400, Color = Color3.fromRGB(92, 201, 138), XP = 10 },
	Rare = { Name = "Rare", Tier = 3, Weight = 120, Color = Color3.fromRGB(90, 169, 240), XP = 25 },
	Epic = { Name = "Epic", Tier = 4, Weight = 30, Color = Color3.fromRGB(176, 124, 240), XP = 60 },
	Legendary = { Name = "Legendary", Tier = 5, Weight = 6, Color = Color3.fromRGB(242, 169, 59), XP = 150 },
	Mythic = { Name = "Mythic", Tier = 6, Weight = 1, Color = Color3.fromRGB(242, 102, 139), XP = 400 },
}

return Rarities
]]></ProtectedString>
						<string name="ScriptGuid">{CEAEDFDA-F67C-4761-AC13-0AA0E07BD083}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Rarities</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">7672d16ab309499b0b0c9ea4000003ea</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="14">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Every gameplay stat in one place. Items (rods, lines, baits, auras, gamepasses, skills...)
-- only declare additive bonuses: `Stats = { Luck = 0.15, CatchBarSize = 0.02 }`.
-- Stats.Compute() sums Base + all bonuses, then clamps to [Min, Max].
-- To add a new stat: add it here, then read it where it matters (e.g. FishingService).

export type StatDef = {
	Base: number,
	Min: number?,
	Max: number?,
	Display: string,
	Percent: boolean?,
}

local StatDefs: { [string]: StatDef } = {
	Luck = { Base = 0, Min = 0, Display = "Luck", Percent = true }, -- +1.0 = +100% luck
	CatchBarSize = { Base = 0.22, Min = 0.08, Max = 0.6, Display = "Catch Bar", Percent = true }, -- fraction of bar height
	ReelPower = { Base = 1, Min = 0.2, Display = "Reel Power" }, -- progress gain multiplier
	Resilience = { Base = 0, Min = 0, Max = 0.9, Display = "Resilience", Percent = true }, -- reduces progress loss
	FishStability = { Base = 0, Min = 0, Max = 0.8, Display = "Fish Stability", Percent = true }, -- calms fish movement
	MaxDepth = { Base = 0, Min = 0, Display = "Max Depth" }, -- metres, set by Line
	BiteSpeed = { Base = 0, Min = 0, Max = 0.8, Display = "Bite Speed", Percent = true }, -- shortens bite wait
	AutoMultiplier = { Base = 1.0, Min = 0, Display = "Auto Sell Mult" },
	AutoSpeed = { Base = 0, Min = 0, Max = 0.75, Display = "Auto Speed", Percent = true },
	MutationChance = { Base = 0, Min = 0, Display = "Mutation Chance", Percent = true }, -- added to every mutation
	SellMultiplier = { Base = 1, Min = 0, Display = "Sell Mult" },
	XPMultiplier = { Base = 1, Min = 0, Display = "XP Mult" },
	ExtraLines = { Base = 0, Min = 0, Max = 9, Display = "Extra Lines" }, -- reserved for Multi-Cast (Phase 3)
}

return StatDefs
]]></ProtectedString>
