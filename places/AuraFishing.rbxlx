				<Item class="ModuleScript" referent="26">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Aura rolling, equipping and VFX (GDD 5). Visuals are built from Config/Auras `Visual` data,
-- so new auras need no code. Swap in hand-made VFX later by putting a model named after the aura
-- id in ReplicatedStorage.AuraVFX (its Attachments/emitters get cloned onto the character).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared.Registry)
local Remotes = require(Shared.Remotes)
local Roll = require(Shared.Roll)
local Format = require(Shared.Util.Format)

local DataService = require(script.Parent.DataService)

local GameConfig = Registry.GameConfig

local AuraService = {}

local rng = Random.new()
local VFX_NAME = "AuraVFX"

local function clearVFX(character: Model)
	for _, d in character:GetDescendants() do
		if d.Name == VFX_NAME then
			d:Destroy()
		end
	end
end

local function buildVFX(character: Model, auraId: string)
	clearVFX(character)
	local aura = Registry.Auras[auraId]
	local root = character:FindFirstChild("HumanoidRootPart")
	if not aura or not root then
		return
	end

	local custom = ReplicatedStorage:FindFirstChild("AuraVFX")
	local template = custom and custom:FindFirstChild(auraId)
	if template then
		for _, child in template:GetChildren() do
			local c = child:Clone()
			c.Name = VFX_NAME
			c.Parent = root
		end
		return
	end

	local v = aura.Visual
	local att = Instance.new("Attachment")
	att.Name = VFX_NAME
	att.Position = Vector3.new(0, -1.5, 0)
	att:SetAttribute("AuraId", auraId)
	att.Parent = root

	local pe = Instance.new("ParticleEmitter")
	pe.Name = "Particles"
	local c1 = v.Color[1]
	local c2 = v.Color[2] or c1
	pe.Color = ColorSequence.new(c1, c2)
	pe.Rate = v.Rate
	pe.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, v.Size),
		NumberSequenceKeypoint.new(1, 0),
	})
	pe.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	pe.Lifetime = NumberRange.new(v.Lifetime * 0.7, v.Lifetime)
	pe.Speed = NumberRange.new(v.Speed * 0.5, v.Speed)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(0, 2, 0)
	pe.LightEmission = v.LightEmission
	pe.Shape = Enum.ParticleEmitterShape.Cylinder
	pe.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
	pe.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
	if v.Spin then
		pe.RotSpeed = NumberRange.new(-180, 180)
		pe.Rotation = NumberRange.new(0, 360)
	end
	if v.Texture then
		pe.Texture = v.Texture
	end
	pe.Parent = att

	if v.Light then
		local light = Instance.new("PointLight")
		light.Color = c1
		light.Range = 10
		light.Brightness = 1.5
		light.Parent = att
	end
end

local function refresh(player: Player)
	local data = DataService.Get(player)
	local char = player.Character
	if not data or not char then
		return
	end
	if data.Auras.Equipped then
		buildVFX(char, data.Auras.Equipped)
	else
		clearVFX(char)
	end
end

-- Returns ok, auraId | message, isNew, equippedNow
function AuraService.Roll(player: Player): (boolean, string, boolean?, boolean?)
	local data = DataService.Get(player)
	if not data then
		return false, "Invalid request"
	end
	local currency = GameConfig.AuraRollCurrency
	if data[currency] < GameConfig.AuraRollCost then
		return false, `Need {GameConfig.AuraRollCost} {currency} to roll`
	end
	data[currency] -= GameConfig.AuraRollCost
	data.Auras.TotalRolls += 1

	local auraId = Roll.Aura(0, rng)
	local isNew = (data.Auras.Owned[auraId] or 0) == 0
	data.Auras.Owned[auraId] = (data.Auras.Owned[auraId] or 0) + 1

	-- Auto-equip if rarer than current.
	local current = data.Auras.Equipped and Registry.Auras[data.Auras.Equipped]
	if not current or Registry.Auras[auraId].Chance > current.Chance then
		data.Auras.Equipped = auraId
		refresh(player)
	end
	DataService.MarkDirty(player)

	-- Legendary+ : server-wide announcement after the reel has finished on the roller's screen
	local aura = Registry.Auras[auraId]
	local rarity = Registry.Rarities[aura.Rarity]
	if rarity.Tier >= 5 then
		task.delay(3.5, function()
			Remotes.Event("Notify"):FireAllClients(`{player.DisplayName} rolled {aura.Name} ({Format.Chance(aura.Chance)})!`, rarity.Color)
		end)
	end
	return true, auraId, isNew, data.Auras.Equipped == auraId
end

function AuraService.Equip(player: Player, auraId: any): (boolean, string)
	local data = DataService.Get(player)
	if not data then
		return false, "Invalid request"
	end
	if auraId == nil then
		data.Auras.Equipped = nil
	elseif type(auraId) == "string" and (data.Auras.Owned[auraId] or 0) > 0 then
		data.Auras.Equipped = auraId
	else
		return false, "Not owned"
	end
	refresh(player)
	DataService.MarkDirty(player)
	return true, "OK"
end

function AuraService.Init()
	local lastRoll: { [Player]: number } = {}
	local function canRoll(player: Player): boolean
		local now = os.clock()
		if lastRoll[player] and now - lastRoll[player] < 0.4 then
			return false
		end
		lastRoll[player] = now
		return true
	end

	Remotes.Func("RollAura").OnServerInvoke = function(player)
		if not canRoll(player) then
			return false, "Slow down"
		end
		return AuraService.Roll(player)
	end
	Remotes.Func("EquipAura").OnServerInvoke = function(player, auraId)
		return AuraService.Equip(player, auraId)
	end

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(char)
			char:WaitForChild("HumanoidRootPart", 10)
			DataService.WaitFor(player)
			refresh(player)
		end)
		if player.Character then
			task.spawn(function()
				DataService.WaitFor(player)
				refresh(player)
			end)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
	Players.PlayerRemoving:Connect(function(p)
		lastRoll[p] = nil
	end)

	-- World altar prompt
	local notify = Remotes.Event("Notify")
	task.spawn(function()
		local map = Workspace:WaitForChild("Map", 30)
		local altar = map and map:FindFirstChild("AuraAltar", true)
		local prompt = altar and altar:FindFirstChild("RollPrompt")
		if prompt and prompt:IsA("ProximityPrompt") then
			prompt.Triggered:Connect(function(player)
				if not canRoll(player) then
					return
				end
				local ok, result, isNew, equipped = AuraService.Roll(player)
				if ok then
					Remotes.Event("AuraRolled"):FireClient(player, result, isNew, equipped)
				else
					notify:FireClient(player, result, Color3.fromRGB(220, 90, 90))
				end
			end)
		end
	end)
end

return AuraService
]]></ProtectedString>
						<string name="ScriptGuid">{1D51195A-A744-4B02-89D5-795A965C133C}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">AuraService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">7672d16ab309499b0b0c9ea4000003f6</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="27">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Player save data: load, reconcile with template, autosave, save on leave / shutdown,
-- and replicate a snapshot to the owning client.
--
-- Other services mutate `DataService.Get(player)` directly, then call
-- `DataService.MarkDirty(player)` so the client gets a fresh snapshot.
--
-- Adding a new saved field: add it to TEMPLATE. Existing saves get it automatically (Reconcile).

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared.Registry)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Util.Signal)

local GameConfig = Registry.GameConfig

local DataService = {}
DataService.ProfileLoaded = Signal.new() -- (player, profile)

local SCHEMA_VERSION = 1

local function buildTemplate()
	local owned = {}
	local equipped = {}
	local consumables = {}
	for catId, cat in Registry.Equipment do
		if cat.Kind == "Permanent" then
			local starter = Registry.StarterItem(catId)
			owned[catId] = {}
			if starter then
				owned[catId][starter] = true
				equipped[catId] = starter
			end
		else
			consumables[catId] = {}
		end
	end
	return {
		Version = SCHEMA_VERSION,
		Coins = GameConfig.StartingCoins,
		Gems = GameConfig.StartingGems,
		Level = 1,
		XP = 0,
		Owned = owned,
		Equipped = equipped,
		Consumables = consumables,
		Auras = { Owned = {}, Equipped = nil, TotalRolls = 0 },
		Bag = {},
		Fishdex = {},
		Settings = { LowFX = false, TargetDepth = 10, AutoDepth = false },
		Lifetime = { Caught = 0, CoinsEarned = 0 },
		NextUid = 1,
	}
end

local TEMPLATE = buildTemplate()

local function deepCopy(t: any): any
	if type(t) ~= "table" then
		return t
	end
	local c = {}
	for k, v in t do
		c[k] = deepCopy(v)
	end
	return c
end

-- Fill missing keys from template (recursively), never overwriting existing data.
local function reconcile(data: any, template: any)
	for k, v in template do
		if data[k] == nil then
			data[k] = deepCopy(v)
		elseif type(v) == "table" and type(data[k]) == "table" then
			reconcile(data[k], v)
		end
	end
end

-- Content can be removed from config later; drop references to things that no longer exist.
local function sanitize(data: any)
	for catId, cat in Registry.Equipment do
		if data.Equipped[catId] and not cat.Items[data.Equipped[catId]] then
			data.Equipped[catId] = Registry.StarterItem(catId)
		end
	end
	if data.Auras.Equipped and not Registry.Auras[data.Auras.Equipped] then
		data.Auras.Equipped = nil
	end
	local bag = {}
	for _, entry in data.Bag do
		if Registry.Fish[entry.Fish] then
			table.insert(bag, entry)
		end
	end
	data.Bag = bag
end

local store: DataStore? = nil
local storeOk, storeErr = pcall(function()
	store = DataStoreService:GetDataStore(GameConfig.DataStoreName)
end)
if not storeOk then
	warn("[DataService] DataStore unavailable, running without saves:", storeErr)
end

local profiles: { [Player]: any } = {}
local dirty: { [Player]: boolean } = {}
local loaded: { [Player]: boolean } = {}

local function key(player: Player): string
	return "Player_" .. player.UserId
end

local function load(player: Player): any
	if not store then
		return deepCopy(TEMPLATE)
	end
	for attempt = 1, 4 do
		local ok, result = pcall(function()
			return (store :: DataStore):GetAsync(key(player))
		end)
		if ok then
			return result or deepCopy(TEMPLATE)
		end
		warn(`[DataService] load attempt {attempt} failed for {player.Name}: {result}`)
		if RunService:IsStudio() then
			-- Usually "Studio access to API services" is off. Play without saving.
			warn("[DataService] Studio: enable Game Settings > Security > 'Studio Access to API Services' to test saving. Using a fresh profile.")
			store = nil
			return deepCopy(TEMPLATE)
		end
		task.wait(attempt)
	end
	return nil
end

local function save(player: Player)
	local data = profiles[player]
	if not data or not store or not loaded[player] then
		return
	end
	local copy = deepCopy(data)
	for attempt = 1, 3 do
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(key(player), function()
				return copy
			end)
		end)
		if ok then
			return
		end
		warn(`[DataService] save attempt {attempt} failed for {player.Name}: {err}`)
		task.wait(attempt)
	end
end

function DataService.Get(player: Player): any
	return profiles[player]
end

function DataService.WaitFor(player: Player): any
	while player.Parent and not profiles[player] do
		task.wait()
	end
	return profiles[player]
end

function DataService.MarkDirty(player: Player)
	dirty[player] = true
end

function DataService.NextUid(player: Player): string
	local data = profiles[player]
	local uid = tostring(data.NextUid)
	data.NextUid += 1
	return uid
end

function DataService.Init()
	local sync = Remotes.Event("DataSync")

	local function onPlayerAdded(player: Player)
		local data = load(player)
		if not player.Parent then
			return
		end
		if not data then
			player:Kick("Could not load your data. Please rejoin.")
			return
		end
		reconcile(data, TEMPLATE)
		sanitize(data)
		profiles[player] = data
		loaded[player] = true
		dirty[player] = true

		local ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		local coins = Instance.new("IntValue")
		coins.Name = "Coins"
		coins.Parent = ls
		local level = Instance.new("IntValue")
		level.Name = "Level"
		level.Parent = ls
		ls.Parent = player

		DataService.ProfileLoaded:Fire(player, data)
	end

	Remotes.Event("ClientReady").OnServerEvent:Connect(function(player)
		if profiles[player] then
			dirty[player] = true
		end
	end)

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayerAdded, p)
	end

	Players.PlayerRemoving:Connect(function(player)
		save(player)
		profiles[player] = nil
		dirty[player] = nil
		loaded[player] = nil
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local threads = {}
		for _, p in Players:GetPlayers() do
			table.insert(threads, task.spawn(save, p))
		end
		task.wait(3)
	end)

	-- Replicate dirty profiles (batched, max ~10 per second per player).
	task.spawn(function()
		while true do
			task.wait(0.1)
			for player, isDirty in dirty do
				if isDirty and profiles[player] then
					dirty[player] = false
					local data = profiles[player]
					local ls = player:FindFirstChild("leaderstats")
					if ls then
						(ls:FindFirstChild("Coins") :: IntValue).Value = data.Coins;
						(ls:FindFirstChild("Level") :: IntValue).Value = data.Level
					end
					sync:FireClient(player, data)
				end
			end
		end
	end)

	-- Autosave
	task.spawn(function()
		while true do
			task.wait(GameConfig.AutosaveInterval)
			for _, p in Players:GetPlayers() do
				task.spawn(save, p)
			end
		end
	end)
end

return DataService
]]></ProtectedString>
						<string name="ScriptGuid">{F0376156-E600-4C41-9E07-94ACD03E04F1}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">DataService</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">7672d16ab309499b0b0c9ea4000003f7</UniqueId>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="28">
					<Properties>
						<Content name="LinkedSource"><null></null></Content>
						<ProtectedString name="Source"><![CDATA[--!strict
-- Server-authoritative fishing loop (GDD 2, 3, 10.1).
--
-- Manual:  Cast(depth) -> wait -> Bite(!) -> Hook -> StartMinigame -> ReelResult -> award (x1.5)
-- Auto:    SetAuto(true) -> every AutoCycleTime: roll + award (x AutoMultiplier)
--
-- The server rolls the fish when it bites and never trusts the client with outcomes. The client
-- only reports whether it won the minigame; the server rejects results that finish faster than
-- the theoretical minimum for that fish + rod.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared.Registry)
local Remotes = require(Shared.Remotes)
local Stats = require(Shared.Stats)
local Roll = require(Shared.Roll)
local Signal = require(Shared.Util.Signal)

local DataService = require(script.Parent.DataService)
local ProgressionService = require(script.Parent.ProgressionService)

local GameConfig = Registry.GameConfig
local MG = GameConfig.Minigame

local FishingService = {}
FishingService.FishCaught = Signal.new() -- (player, entry, mode) hook for quests/boss/events later

type State = {
	Phase: string, -- "Idle" | "Waiting" | "Bite" | "Reeling" | "Auto"
	Token: string,
	Fish: string?,
	Depth: number,
	LocationId: string?,
	Origin: Vector3?,
	ReelStart: number,
	MinDuration: number,
	LastCast: number,
	AutoGen: number,
	Bobber: Instance?,
}

local states: { [Player]: State } = {}
local rng = Random.new()

local notify: RemoteEvent
local stateEvent: RemoteEvent

local function getState(player: Player): State
	local s = states[player]
	if not s then
		s = { Phase = "Idle", Token = "", Depth = 0, ReelStart = 0, MinDuration = 0, LastCast = 0, AutoGen = 0 }
		states[player] = s
	end
	return s
end

local function setPhase(player: Player, phase: string, info: any?)
	local s = getState(player)
	s.Phase = phase
	stateEvent:FireClient(player, phase, info)
end

local function clearBobber(s: State)
	if s.Bobber then
		s.Bobber:Destroy()
		s.Bobber = nil
	end
end

local function reset(player: Player, keepAuto: boolean?)
	local s = getState(player)
	clearBobber(s)
	s.Token = ""
	s.Fish = nil
	if keepAuto and s.Phase == "Auto" then
		return
	end
	setPhase(player, "Idle")
end

local function bagCapacity(data: any): number
	local bag = Registry.Equipment.Bags.Items[data.Equipped.Bags]
	return bag and bag.Capacity or 10
end

local function rootOf(player: Player): BasePart?
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not char or not hum or hum.Health <= 0 then
		return nil
	end
	return char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function zoneAt(point: Vector3): string?
	for _, zone in CollectionService:GetTagged("FishingZone") do
		if zone:IsA("BasePart") then
			local localPos = zone.CFrame:PointToObjectSpace(point)
			local half = zone.Size / 2
			if math.abs(localPos.X) <= half.X and math.abs(localPos.Y) <= half.Y and math.abs(localPos.Z) <= half.Z then
				return zone:GetAttribute("LocationId") :: string?
			end
		end
	end
	return nil
end

-- Finds where the bobber lands in front of the player. Returns water point + location id.
local function findCastPoint(root: BasePart): (Vector3?, string?)
	local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	if look.Magnitude < 0.01 then
		return nil, nil
	end
	local target = root.Position + look.Unit * GameConfig.CastDistance
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { root.Parent :: Instance }
	params.IgnoreWater = false
	local hit = Workspace:Raycast(target + Vector3.new(0, 20, 0), Vector3.new(0, -60, 0), params)
	if not hit or hit.Material ~= Enum.Material.Water then
		return nil, nil
	end
	local loc = zoneAt(hit.Position)
	if not loc or not Registry.Locations[loc] then
		return nil, nil
	end
	return hit.Position, loc
end

local function spawnBobber(player: Player, point: Vector3): Instance
	local folder = Workspace:FindFirstChild("Bobbers") or Instance.new("Folder")
	folder.Name = "Bobbers"
	folder.Parent = Workspace

	local bobber = Instance.new("Part")
	bobber.Name = player.Name
	bobber.Shape = Enum.PartType.Ball
	bobber.Size = Vector3.new(0.8, 0.8, 0.8)
	bobber.Color = Color3.fromRGB(255, 60, 60)
	bobber.Material = Enum.Material.SmoothPlastic
	bobber.Anchored = true
	bobber.CanCollide = false
	bobber.CanQuery = false
	bobber.Position = point + Vector3.new(0, 0.2, 0)

	local a1 = Instance.new("Attachment")
	a1.Parent = bobber
	local char = player.Character
	local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm"))
	if hand then
		local a0 = Instance.new("Attachment")
		a0.Name = "FishingLineAttachment"
		a0.Parent = hand
		bobber.Destroying:Connect(function()
			a0:Destroy()
		end)
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Width0 = 0.05
		beam.Width1 = 0.05
		beam.CurveSize0 = 2
		beam.Color = ColorSequence.new(Color3.fromRGB(240, 240, 240))
		beam.FaceCamera = true
		beam.Parent = bobber
	end
	bobber.Parent = folder
	return bobber
end

local function allowedDepth(data: any, stats: Stats.ComputedStats, locationId: string?): number
	local cap = stats.Values.MaxDepth
	local loc = locationId and Registry.Locations[locationId]
	if loc then
		cap = math.min(cap, loc.MaxDepth)
	end
	return cap
end

-- Theoretical fastest win: progress from StartProgress to 1 with no losses.
local function minDuration(stats: Stats.ComputedStats): number
	local gain = MG.GainPerSecond * stats.Values.ReelPower
	return (1 - MG.StartProgress) / gain
end

local function consumeBait(data: any)
	local baitId = data.Equipped.Baits
	if not baitId then
		return
	end
	local stack = data.Consumables.Baits
	if stack[baitId] and stack[baitId] > 0 then
		stack[baitId] -= 1
	end
end

-- Gives the fish to the player. mode = "Manual" | "Auto".
local function award(player: Player, fishId: string, mult: number, mode: string, perfect: boolean?)
	local data = DataService.Get(player)
	if not data then
		return
	end
	local stats = Stats.Compute(data)
	local fish = Registry.Fish[fishId]
	local rarity = Registry.Rarities[fish.Rarity]

	local entry: Roll.CatchEntry = {
		Uid = DataService.NextUid(player),
		Fish = fishId,
		Weight = Roll.Weight(fishId, rng),
		Mutation = Roll.Mutation(stats.Values.MutationChance, stats.MutationBonus, rng),
		Mult = mult,
	}
	table.insert(data.Bag, entry)
	consumeBait(data)

	local dex = data.Fishdex[fishId]
	local isNew = dex == nil
	if not dex then
		dex = { Count = 0, Best = 0 }
		data.Fishdex[fishId] = dex
	end
	dex.Count += 1
	dex.Best = math.max(dex.Best, entry.Weight)
	data.Lifetime.Caught += 1

	local gems = GameConfig.GemsByRarityTier[rarity.Tier] or 0
	data.Gems += gems

	local xp = rarity.XP * stats.Values.XPMultiplier * (mode == "Manual" and GameConfig.ManualMultiplier or 1)
	local levels = ProgressionService.AddXP(player, xp)

	DataService.MarkDirty(player)
	Remotes.Event("CatchResult"):FireClient(player, {
		Entry = entry,
		Value = Roll.Value(entry, stats.Values.SellMultiplier),
		Mode = mode,
		Perfect = perfect == true,
		New = isNew,
		Gems = gems,
		LevelsGained = levels,
		BagCount = #data.Bag,
		BagCapacity = bagCapacity(data),
	})
	FishingService.FishCaught:Fire(player, entry, mode)
end

-- MANUAL -----------------------------------------------------------------

local function onCast(player: Player, depth: any)
	if type(depth) ~= "number" or depth ~= depth then
		return
	end
	local data = DataService.Get(player)
	local s = getState(player)
	if not data or s.Phase ~= "Idle" then
		return
	end
	local now = os.clock()
	if now - s.LastCast < GameConfig.CastCooldown then
		return
	end
	s.LastCast = now

	if #data.Bag >= bagCapacity(data) then
		notify:FireClient(player, "Your bag is full! Sell your fish at the Merchant.", Color3.fromRGB(224, 100, 60))
		return
	end
	local root = rootOf(player)
	if not root then
		return
	end
	local point, locationId = findCastPoint(root)
	if not point then
		notify:FireClient(player, "Face the water to cast!", Color3.fromRGB(224, 140, 60))
		return
	end

	local stats = Stats.Compute(data)
	local maxDepth = allowedDepth(data, stats, locationId)
	if depth < 0 then
		-- Auto depth (Cast popup checkbox): random reachable depth every cast
		depth = rng:NextInteger(0, math.max(0, math.floor(maxDepth)))
	else
		depth = math.clamp(math.floor(depth), 0, maxDepth)
		data.Settings.TargetDepth = depth
	end

	local token = HttpService:GenerateGUID(false)
	s.Token = token
	s.Depth = depth
	s.LocationId = locationId
	s.Origin = root.Position
	s.Bobber = spawnBobber(player, point)
	setPhase(player, "Waiting", { Depth = depth })

	local wait = rng:NextNumber(GameConfig.BiteWait[1], GameConfig.BiteWait[2]) * (1 - stats.Values.BiteSpeed)
	task.delay(wait, function()
		if s.Token ~= token or (s.Phase :: string) ~= "Waiting" then
			return
		end
		local fishId = Roll.Fish(depth, locationId, stats.Values.Luck, rng)
		if not fishId then
			notify:FireClient(player, `Nothing lives at {depth}m here. Try another depth.`, Color3.fromRGB(110, 120, 200))
			reset(player)
			return
		end
		s.Fish = fishId
		setPhase(player, "Bite", { Rarity = Registry.Fish[fishId].Rarity })
		Remotes.Event("Bite"):FireClient(player, token, { Rarity = Registry.Fish[fishId].Rarity })
		task.delay(GameConfig.BiteWindow, function()
			if s.Token == token and (s.Phase :: string) == "Bite" then
				notify:FireClient(player, "It got away... click faster when you see '!'", Color3.fromRGB(220, 100, 100))
				reset(player)
			end
		end)
	end)
end

local function onHook(player: Player, token: any)
	local s = getState(player)
	if s.Phase ~= "Bite" or token ~= s.Token or not s.Fish then
		return
	end
	local data = DataService.Get(player)
	local stats = Stats.Compute(data)
	local fish = Registry.Fish[s.Fish]
	local pattern = Registry.MinigamePatterns[fish.Pattern]

	s.ReelStart = os.clock()
	s.MinDuration = minDuration(stats)
	setPhase(player, "Reeling")
	Remotes.Event("StartMinigame"):FireClient(player, token, {
		FishName = "???",
		Rarity = fish.Rarity,
		Depth = s.Depth,
		Difficulty = fish.Difficulty,
		Pattern = fish.Pattern,
		PatternDef = pattern,
		CatchBarSize = stats.Values.CatchBarSize,
		ReelPower = stats.Values.ReelPower,
		Resilience = stats.Values.Resilience,
		FishStability = stats.Values.FishStability,
	})
end

local function onReelResult(player: Player, token: any, success: any, perfect: any)
	local s = getState(player)
	if s.Phase ~= "Reeling" or token ~= s.Token or not s.Fish then
		return
	end
	local elapsed = os.clock() - s.ReelStart
	local fishId = s.Fish :: string
	local legit = elapsed >= s.MinDuration * MG.ValidationSlack and elapsed <= MG.MaxDuration + 5
	reset(player)
	if success == true and legit then
		local mult = GameConfig.ManualMultiplier + (perfect == true and GameConfig.PerfectCatchBonus or 0)
		award(player, fishId, mult, "Manual", perfect == true)
	else
		if success == true and not legit then
			warn(`[FishingService] rejected suspicious reel from {player.Name} ({elapsed}s)`)
		end
		notify:FireClient(player, "The line snapped!", Color3.fromRGB(220, 90, 90))
	end
end

-- AUTO -------------------------------------------------------------------

local function autoLoop(player: Player, gen: number)
	local s = getState(player)
	local function running()
		return s.Phase == "Auto" and s.AutoGen == gen and player.Parent ~= nil
	end
	while running() do
		local data = DataService.Get(player)
		local root = rootOf(player)
		if not data or not root then
			break
		end
		if #data.Bag >= bagCapacity(data) then
			notify:FireClient(player, "Bag full - Auto Fishing stopped. Sell your fish!", Color3.fromRGB(224, 100, 60))
			break
		end
		local point, locationId = findCastPoint(root)
		if not point then
			notify:FireClient(player, "Auto Fishing stopped: face the water.", Color3.fromRGB(224, 140, 60))
			break
		end
		local stats = Stats.Compute(data)
		local maxDepth = allowedDepth(data, stats, locationId)
		local depth = if data.Settings.AutoDepth
			then rng:NextInteger(0, math.max(0, math.floor(maxDepth)))
			else math.clamp(data.Settings.TargetDepth or 0, 0, maxDepth)
		clearBobber(s)
		s.Bobber = spawnBobber(player, point)

		local cycle = GameConfig.AutoCycleTime * (1 - stats.Values.AutoSpeed) * (1 - stats.Values.BiteSpeed * 0.5)
		task.wait(cycle)
		if not running() then
			return
		end
		local fishId = Roll.Fish(depth, locationId, stats.Values.Luck, rng)
		if fishId then
			award(player, fishId, stats.Values.AutoMultiplier, "Auto")
		end
	end
	if running() then
		s.Phase = "Idle"
		reset(player)
	end
end

local function onSetAuto(player: Player, enabled: any)
	local s = getState(player)
	if enabled == true and s.Phase == "Idle" then
		s.AutoGen += 1
		setPhase(player, "Auto")
		task.spawn(autoLoop, player, s.AutoGen)
	elseif enabled ~= true and s.Phase == "Auto" then
		s.Phase = "Idle"
		reset(player)
	end
end

-- Updates TargetDepth without casting (auto mode reads it).
function FishingService.SetTargetDepth(player: Player, depth: number)
	local data = DataService.Get(player)
	if data then
		data.Settings.TargetDepth = math.max(0, math.floor(depth))
	end
end

function FishingService.Init()
	notify = Remotes.Event("Notify")
	stateEvent = Remotes.Event("FishingState")

	Remotes.Event("Cast").OnServerEvent:Connect(onCast)
	Remotes.Event("Hook").OnServerEvent:Connect(onHook)
	Remotes.Event("ReelResult").OnServerEvent:Connect(onReelResult)
	Remotes.Event("CancelFishing").OnServerEvent:Connect(function(player)
		local s = getState(player)
		if s.Phase ~= "Auto" then
			reset(player)
		end
	end)
	Remotes.Event("SetAuto").OnServerEvent:Connect(onSetAuto)

	Players.PlayerRemoving:Connect(function(player)
		local s = states[player]
		if s then
			clearBobber(s)
			s.Phase = "Gone"
		end
		states[player] = nil
	end)

	-- Walking away cancels a manual cast.
	task.spawn(function()
		while true do
			task.wait(0.5)
			for player, s in states do
				if s.Phase == "Waiting" or s.Phase == "Bite" then
					local root = rootOf(player)
					if not root or (s.Origin and (root.Position - s.Origin).Magnitude > 8) then
						reset(player)
					end
				end
			end
		end
	end)
end

return FishingService
]]></ProtectedString>
