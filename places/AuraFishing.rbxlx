						<string name="ScriptGuid">{1A8CDC92-457D-4B57-A691-6F4F01576B50}</string>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">Main</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">7672d16ab309499b0b0c9ea400000406</UniqueId>
					</Properties>
				</Item>
				<Item class="Folder" referent="44">
					<Properties>
						<Content name="ExplorerIconContent">
							<null></null>
						</Content>
						<Color3 name="IconTint">
							<R>0</R>
							<G>0</G>
							<B>0</B>
						</Color3>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
						<bool name="DefinesCapabilities">false</bool>
						<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
						<string name="Name">UI</string>
						<BinaryString name="SerializedOverrides"></BinaryString>
						<int64 name="SourceAssetId">-1</int64>
						<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
						<UniqueId name="UniqueId">7672d16ab309499b0b0c9ea400000407</UniqueId>
					</Properties>
					<Item class="ModuleScript" referent="45">
						<Properties>
							<Content name="LinkedSource"><null></null></Content>
							<ProtectedString name="Source"><![CDATA[--!nonstrict
-- Aura Gacha reveal: "Reel Slot" (Figma: Aura Gacha · concept B, CHOSEN).
-- Flow: spin (blur) -> slow down with a near-miss on a rarer orb -> lock (flash, rays, confetti)
-- -> reveal card. Higher rarity = longer build-up; Legendary+ adds shake and a pause.
-- Tap anywhere during the spin to skip to the result.
--
-- AuraReel.Play(auraId, { isNew, equipped, onEquip = fn, onRollAgain = fn })

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Registry = require(Shared.Registry)
local Format = require(Shared.Util.Format)

local New = require(script.Parent.New)

local T = New.Theme
local ITEM = 96 -- strip item height
local WIN_W, WIN_H = 180, 3 * ITEM -- window shows 3 items, centre one is the result
local STRIP_LEN = 28

local AuraReel = {}
local playing = false

local function tierOf(auraId: string): number
	return Registry.Rarities[Registry.Auras[auraId].Rarity].Tier
end

local function rarityColor(auraId: string): Color3
	return Registry.Rarities[Registry.Auras[auraId].Rarity].Color
end

-- A round orb tinted with the aura's Visual colours (no image assets needed).
local function orb(auraId: string, size: number, parent: Instance, z: number?): Frame
	local v = Registry.Auras[auraId].Visual
	local c1 = v.Color[1]
	local c2 = v.Color[2] or c1:Lerp(Color3.new(1, 1, 1), 0.4)
	local f = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = z or 2,
		Parent = parent,
		[New.Children] = {
			New.Pill(),
			New("UIGradient", { Rotation = 90, Color = ColorSequence.new(c1:Lerp(Color3.new(1, 1, 1), 0.35), c2) }),
			New("UIStroke", { Color = Color3.new(1, 1, 1), Thickness = 3 }),
		},
	}) :: Frame
	New("Frame", { -- glossy highlight
		Position = UDim2.fromScale(0.2, 0.14),
		Size = UDim2.fromScale(0.3, 0.22),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.35,
		ZIndex = (z or 2) + 1,
		Parent = f,
		[New.Children] = { New.Pill() },
	})
	return f
end

local function pickStrip(result: string): ({ string }, number)
	-- weighted random filler (common looking), plus a near-miss: the rarest aura above the result
	local ids = Registry.SortedAuras()
	local strip = {}
	local rng = Random.new()
	for i = 1, STRIP_LEN do
		local id = ids[rng:NextInteger(1, math.min(#ids, 3 + math.floor(i / 8)))]
		strip[i] = id
	end
	local resultIndex = STRIP_LEN - 2
	strip[resultIndex] = result
	local rarer = nil
	for _, id in ids do
		if Registry.Auras[id].Chance > Registry.Auras[result].Chance then
			rarer = id -- ids are sorted common -> rare; keep the rarest
		end
	end
	if rarer then
		strip[resultIndex - 1] = rarer -- passes the centre line just before the stop
	end
	return strip, resultIndex
end

local function confetti(parent: Instance, center: Vector2, count: number)
	local cols = { T.Accent, T.Good, T.Sky, T.Gold, T.Gem }
	local rng = Random.new()
	for i = 1, count do
		local piece = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(center.X, center.Y),
			Size = UDim2.fromOffset(8, 12),
			Rotation = rng:NextNumber(0, 360),
			BackgroundColor3 = cols[(i % #cols) + 1],
			ZIndex = 30,
			Parent = parent,
			[New.Children] = { New.Corner(2) },
		})
		local a = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(140, 320)
		local target = UDim2.fromOffset(center.X + math.cos(a) * dist, center.Y + math.sin(a) * dist * 0.7 + 120)
		local tw = TweenService:Create(piece, TweenInfo.new(rng:NextNumber(0.9, 1.4), Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Position = target, Rotation = piece.Rotation + rng:NextNumber(-360, 360), BackgroundTransparency = 1 })
		tw:Play()
		tw.Completed:Once(function()
			piece:Destroy()
		end)
	end
end

local function rays(parent: Instance, color: Color3, z: number): Frame
	local holder = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(620, 620),
		BackgroundTransparency = 1,
		ZIndex = z,
		Parent = parent,
	}) :: Frame
	for i = 0, 11 do
		New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(34, 620),
			Rotation = i * 15,
			BackgroundColor3 = color,
			BackgroundTransparency = 0.72,
			BorderSizePixel = 0,
			ZIndex = z,
			Parent = holder,
			[New.Children] = { New("UIGradient", { Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }) },
		})
	end
	return holder
end

function AuraReel.IsPlaying(): boolean
	return playing
end

function AuraReel.Play(auraId: string, opts: any?)
	opts = opts or {}
	if playing or not Registry.Auras[auraId] then
		return
	end
	playing = true
	local aura = Registry.Auras[auraId]
	local rarity = Registry.Rarities[aura.Rarity]
	local tier = tierOf(auraId)
	local col = rarityColor(auraId)

	local gui = New("ScreenGui", {
		Name = "AuraReel",
		DisplayOrder = 30,
		IgnoreGuiInset = true,
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Global,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local dim = New("TextButton", { -- also the "tap to skip" surface
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(26, 33, 64),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 1,
		Parent = gui,
	})
	TweenService:Create(dim, TweenInfo.new(0.25), { BackgroundTransparency = 0.25 }):Play()

	-- reel window
	local window = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(WIN_W, WIN_H),
		BackgroundColor3 = T.Panel,
		ClipsDescendants = true,
		ZIndex = 10,
		Parent = gui,
		[New.Children] = { New.Corner(28) },
	})
	local frameStroke = New("UIStroke", { Color = T.Gold, Thickness = 5, Parent = window })
	New("Frame", { -- centre line
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.3,
		ZIndex = 14,
		Parent = window,
	})
	local hint = New.Title({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.42, WIN_H / 2 + 20),
		Size = UDim2.fromOffset(320, 30),
		Text = "SPINNING!",
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.4,
		MaxTextSize = 26,
		ZIndex = 12,
		Parent = gui,
	})

	local strip, resultIndex = pickStrip(auraId)
	local stripFrame = New("Frame", { Size = UDim2.fromOffset(WIN_W, ITEM * #strip), BackgroundTransparency = 1, ZIndex = 11, Parent = window })
	for i, id in strip do
		local o = orb(id, 74, stripFrame, 12)
		o.Position = UDim2.fromOffset(WIN_W / 2, (i - 0.5) * ITEM)
	end
	-- start with item 2 centred, end with resultIndex centred
	local function yFor(index: number): number
		return WIN_H / 2 - (index - 0.5) * ITEM
	end
	stripFrame.Position = UDim2.fromOffset(0, yFor(2))
	local duration = 2.0 + 0.35 * tier
	local spin = TweenService:Create(stripFrame, TweenInfo.new(duration, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
		{ Position = UDim2.fromOffset(0, yFor(resultIndex)) })

	-- per-item "tick" pop + rarity hint near the end
	local lastIndex = 2
	local startClock = os.clock()
	local tickConn = RunService.RenderStepped:Connect(function()
		local idx = math.floor((WIN_H / 2 - stripFrame.Position.Y.Offset) / ITEM) + 1
		if idx ~= lastIndex then
			lastIndex = idx
			window.Size = UDim2.fromOffset(WIN_W + 6, WIN_H + 6)
			TweenService:Create(window, TweenInfo.new(0.08), { Size = UDim2.fromOffset(WIN_W, WIN_H) }):Play()
		end
		local t = (os.clock() - startClock) / duration
		if t > 0.7 then
			frameStroke.Color = T.Gold:Lerp(col, math.clamp((t - 0.7) / 0.3, 0, 1))
			hint.Text = "so close..."
		end
	end)

	local done = false
	local function finishSpin()
		if done then
			return
		end
		done = true
		tickConn:Disconnect()
		spin:Cancel()
		stripFrame.Position = UDim2.fromOffset(0, yFor(resultIndex))
		frameStroke.Color = col

		-- Legendary+: shake + dramatic pause
		if tier >= 5 then
			local base = window.Position
			for _ = 1, 10 do
				window.Position = base + UDim2.fromOffset(math.random(-6, 6), math.random(-6, 6))
				task.wait(0.03)
			end
			window.Position = base
			task.wait(0.25)
		end

		-- LOCK: flash + rays + confetti
		local flash = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.15, ZIndex = 40, Parent = gui })
		TweenService:Create(flash, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
		task.delay(0.4, function()
			flash:Destroy()
		end)
		local r = rays(gui, col, 5)
		local spinRays = RunService.RenderStepped:Connect(function(dt)
			r.Rotation += dt * 20
		end)
		local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
		confetti(gui, Vector2.new(vp.X / 2, vp.Y * 0.42), 18 + tier * 6)
		hint.Text = string.upper(rarity.Name) .. "!"
		hint.TextColor3 = col
		task.wait(0.6)

		-- REVEAL card
		window.Visible = false
		hint.Visible = false
		local card = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.45),
			Size = UDim2.fromOffset(380, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = T.Panel,
			ZIndex = 20,
			Parent = gui,
			[New.Children] = {
				New.Corner(28),
				New.Stroke(),
				New.Padding(22),
				New("UIListLayout", { Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
			},
		})
		local scale = New("UIScale", { Scale = 0.6, Parent = card })
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
		New.Text({ Size = UDim2.fromOffset(300, 16), Text = "YOU ROLLED", TextColor3 = T.SubText, MaxTextSize = 13, LayoutOrder = 1, ZIndex = 21, Parent = card })
		local orbHolder = New("Frame", { Size = UDim2.fromOffset(140, 140), BackgroundTransparency = 1, LayoutOrder = 2, ZIndex = 21, Parent = card })
		local big = orb(auraId, 130, orbHolder, 22)
		big.Position = UDim2.fromScale(0.5, 0.5)
		if opts.isNew then -- corner badge (same as the Item Slot "NEW")
			New("TextLabel", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, 4, 0, 4),
				Size = UDim2.fromOffset(0, 22),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = T.Accent,
				Text = "NEW!",
				TextColor3 = T.OnAccent,
				FontFace = T.FontBody,
				TextSize = 12,
				ZIndex = 24,
				Parent = orbHolder,
				[New.Children] = { New.Pill(), New.Stroke(Color3.new(1, 1, 1), 2), New("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }) },
			})
		end
		New.Title({ Size = UDim2.fromOffset(336, 40), Text = aura.Name, TextColor3 = col, MaxTextSize = 34, LayoutOrder = 3, ZIndex = 21, Parent = card })
		local tags = New("Frame", { Size = UDim2.fromOffset(336, 24), BackgroundTransparency = 1, LayoutOrder = 4, ZIndex = 21, Parent = card,
			[New.Children] = { New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center }) } })
		local function pill(text: string, bg: Color3, order: number)
			New("TextLabel", {
				Size = UDim2.fromOffset(0, 22),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = bg,
				Text = text,
				TextColor3 = T.OnAccent,
				FontFace = T.FontBody,
				TextSize = 12,
				LayoutOrder = order,
				ZIndex = 22,
				Parent = tags,
				[New.Children] = { New.Pill(), New("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }) },
			})
		end
		pill(string.upper(rarity.Name), col, 1)
		pill(Format.Chance(aura.Chance), T.SubText, 2)
		local statBadges = {}
		for stat, value in aura.Stats do
			local def = Registry.StatDefs[stat]
			table.insert(statBadges, { Text = if def and def.Percent then `{Format.Percent(value)} {def.Display}` else `+{value} {stat}` })
		end
		for mutId, chance in aura.Mutations or {} do
			local mdef = Registry.Mutations[mutId]
			table.insert(statBadges, { Text = `{Format.Percent(chance)} {mdef.Name}`, Color = mdef.Color })
		end
		New.BadgeRow(statBadges, { Size = UDim2.fromOffset(336, 0), LayoutOrder = 5, ZIndex = 22, Parent = card })

		local buttons = New("Frame", { Size = UDim2.fromOffset(336, 52), BackgroundTransparency = 1, LayoutOrder = 6, ZIndex = 21, Parent = card,
			[New.Children] = { New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center }) } })
		local function close()
			spinRays:Disconnect()
			gui:Destroy()
			playing = false
		end
		local equipBtn = New.Button({ Size = UDim2.fromOffset(104, 50), Text = if opts.equipped then "EQUIPPED" else "EQUIP", BackgroundColor3 = if opts.equipped then T.Good else T.Accent, LayoutOrder = 1, ZIndex = 22, Parent = buttons })
		local againBtn = New.Button({ Size = UDim2.fromOffset(128, 50), Text = "ROLL AGAIN", BackgroundColor3 = T.Gem, LayoutOrder = 2, ZIndex = 22, Parent = buttons })
		local closeBtn = New.Button({ Size = UDim2.fromOffset(88, 50), Text = "CLOSE", LayoutOrder = 3, ZIndex = 22, Parent = buttons })
		equipBtn.Activated:Connect(function()
			if not opts.equipped and opts.onEquip then
				opts.onEquip()
			end
			close()
		end)
		againBtn.Activated:Connect(function()
			close()
			if opts.onRollAgain then
				opts.onRollAgain()
			end
		end)
		closeBtn.Activated:Connect(close)
	end

	dim.Activated:Connect(function()
		if not done then
			task.spawn(finishSpin) -- skip
		end
	end)
	spin:Play()
	spin.Completed:Once(function(state)
		if state == Enum.PlaybackState.Completed then
			task.spawn(finishSpin)
		end
	end)
end

return AuraReel
]]></ProtectedString>
							<string name="ScriptGuid">{552237EE-F1F6-41F8-A811-F364A5B51F6B}</string>
							<BinaryString name="AttributesSerialize"></BinaryString>
